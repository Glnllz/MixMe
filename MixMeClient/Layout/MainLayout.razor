@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject MixMeClient.Services.AuthService Auth
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<div class="app-wrapper">
    @* Фон с «живыми» пятнами *@
    <div class="bg-visual">
        <div class="glow-1"></div>
        <div class="glow-2"></div>
    </div>

    @* Показываем навигацию только если мы НЕ на страницах входа/регистрации/лендинге *@
    @if (ShowNavigation())
    {
        <header class="top-nav fade-in-down">
            <div class="nav-content">
                <div class="brand" @onclick='() => Nav.NavigateTo("/feed")'>
                    <img src="images/logo.png" alt="logo" />
                    <span>MixMe</span>
                </div>

                <nav class="links">
                    <NavLink href="/feed" ActiveClass="active">Лента</NavLink>
                    <NavLink href="/search" ActiveClass="active">Поиск</NavLink>
                    <NavLink href="/rank" ActiveClass="active">Рейтинг</NavLink>
                    <NavLink href="/orders" ActiveClass="active">Мои проекты</NavLink>
                    <NavLink href="/chats" ActiveClass="active">Сообщения</NavLink>
                </nav>

                <div class="user-controls">
                    <div class="search-trigger" @onclick='() => Nav.NavigateTo("/search")'>
                        <i class="bi bi-search"></i>
                    </div>

                    @if (Auth.IsLoggedIn)
                    {
                        <div class="profile-link" @onclick='() => Nav.NavigateTo("/profile")'>
                            <div class="profile-avatar-container">
                                @if (string.IsNullOrEmpty(Auth.User?.AvatarUrl))
                                {
                                    <i class="bi bi-person-fill"></i>
                                }
                                else
                                {
                                    <img src="@GetFullUrl(Auth.User.AvatarUrl)" alt="me" />
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>
    }

    @* Контентная область *@
    <main class="content-area @(ShowNavigation() ? "with-nav" : "full-screen")">
        @Body
    </main>
</div>

@* ГЛОБАЛЬНОЕ УВЕДОМЛЕНИЕ (TOAST) *@
@if (!string.IsNullOrEmpty(lastNotification))
{
    <div class="global-toast animate__animated animate__fadeInRight" @onclick="GoToNotification">
        <div class="toast-icon"><i class="bi bi-chat-fill"></i></div>
        <div class="toast-body">
            <span class="toast-title">Новое сообщение</span>
            <p>@lastNotification</p>
        </div>
        <button class="toast-close" @onclick:stopPropagation @onclick="() => lastNotification = null">&times;</button>
    </div>
}

<style>
    :root {
        --accent: #E91E63;
        --bg: #0B0B0B;
        --glass: rgba(255, 255, 255, 0.04);
        --border: rgba(255, 255, 255, 0.08);
    }

    .app-wrapper {
        min-height: 100vh;
        background: var(--bg);
        color: white;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
    }

    /* Фоновые эффекты */
    .bg-visual {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .glow-1 {
        position: absolute;
        top: -10%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(233, 30, 99, 0.15) 0%, transparent 70%);
        filter: blur(60px);
    }

    .glow-2 {
        position: absolute;
        bottom: -5%;
        left: -5%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(233, 30, 99, 0.1) 0%, transparent 70%);
        filter: blur(60px);
    }

    /* Навигация */
    .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 70px;
        background: rgba(11, 11, 11, 0.7);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border);
        z-index: 1000;
        display: flex;
        justify-content: center;
    }

    .nav-content {
        width: 100%;
        max-width: 1400px;
        padding: 0 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
    }

        .brand img {
            height: 32px;
        }

        .brand span {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

    .links {
        display: flex;
        gap: 40px;
    }

        .links a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: 0.3s;
        }

            .links a:hover, .links a.active {
                color: white;
            }

    .user-controls {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .search-trigger {
        color: rgba(255,255,255,0.5);
        cursor: pointer;
        font-size: 1.1rem;
    }

    .profile-avatar-container {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: var(--accent);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid rgba(255,255,255,0.1);
        transition: 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

        .profile-avatar-container:hover {
            transform: scale(1.08) rotate(3deg);
            border-color: var(--accent);
            box-shadow: 0 0 20px rgba(233, 30, 99, 0.4);
        }

        .profile-avatar-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-avatar-container i {
            font-size: 1.3rem;
            color: white;
        }

    .content-area {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .content-area.with-nav {
            padding-top: 100px;
        }

        .content-area.full-screen {
            padding-top: 0;
        }

    /* --- СТИЛИ УВЕДОМЛЕНИЯ (TOAST) --- */
    .global-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid var(--accent);
        border-radius: 22px;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 9999;
        cursor: pointer;
        box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 20px rgba(233, 30, 99, 0.2);
        max-width: 380px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .global-toast:hover {
            transform: translateY(-5px) scale(1.02);
            background: #151515;
        }

    .toast-icon {
        width: 48px;
        height: 48px;
        background: var(--accent);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        box-shadow: 0 8px 15px rgba(233, 30, 99, 0.3);
    }

    .toast-title {
        display: block;
        font-weight: 900;
        font-size: 0.75rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 2px;
    }

    .toast-body p {
        margin: 0;
        font-size: 0.95rem;
        color: rgba(255,255,255,0.9);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 500;
    }

    .toast-close {
        background: transparent;
        border: none;
        color: rgba(255,255,255,0.2);
        font-size: 1.8rem;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: 0.2s;
    }

        .toast-close:hover {
            color: white;
        }

    .fade-in-down {
        animation: fadeInDown 0.5s ease forwards;
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private string BaseApiUrl = "https://localhost:7237";
    private HubConnection? hubConnection;
    private string? lastNotification;
    private string? lastNotificationOrderId;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += HandleLocationChanged;

        // Если пользователь уже вошел в систему при загрузке страницы
        if (Auth.IsLoggedIn)
        {
            await StartGlobalNotificationHub();
        }
    }

    private async Task StartGlobalNotificationHub()
    {
        try
        {
            if (hubConnection != null) return; // Чтобы не плодить подключения

            hubConnection = new HubConnectionBuilder()
                .WithUrl(BaseApiUrl + "/chathub")
                .WithAutomaticReconnect()
                .Build();

            // Принимаем 3 параметра: OrderId, Имя пользователя, Текст сообщения
            hubConnection.On<string, string, string>("ReceiveMessage", (orderId, user, message) =>
            {
                // Проверяем, не находимся ли мы уже в этом чате
                bool isCurrentlyInThisOrder = Nav.Uri.Contains($"/order/{orderId}");
                bool isMessageFromMe = user == Auth.User?.Username;

                if (!isCurrentlyInThisOrder && !isMessageFromMe)
                {
                    lastNotification = $"{user}: {message}";
                    lastNotificationOrderId = orderId;
                    InvokeAsync(StateHasChanged);

                    // Авто-скрытие уведомления через 6 секунд
                    _ = Task.Delay(6000).ContinueWith(_ =>
                    {
                        lastNotification = null;
                        InvokeAsync(StateHasChanged);
                    });
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR Global Hub Error: {ex.Message}");
        }
    }

    private void GoToNotification()
    {
        if (!string.IsNullOrEmpty(lastNotificationOrderId))
        {
            Nav.NavigateTo($"/order/{lastNotificationOrderId}");
            lastNotification = null;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool ShowNavigation()
    {
        var relativeUri = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        var pathOnly = relativeUri.Split('?')[0];
        return !(string.IsNullOrEmpty(pathOnly) || pathOnly.Contains("login") || pathOnly.Contains("register"));
    }

    private string GetFullUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        return url.StartsWith("http") ? url : $"{BaseApiUrl}/{url.TrimStart('/')}";
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}