@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject MixMeClient.Services.AuthService Auth
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@using MixMeShared

<div class="app-wrapper">
    @* СЛОЙ С ФОНОМ И РОЗОВЫМИ КРУГАМИ *@
    <div class="bg-visual">
        <div class="glow-1"></div>
        <div class="glow-2"></div>
    </div>

    @if (!isReady)
    {
        <div class="loader-startup"></div>
    }
    else
    {
        @* 1. ШАПКА: Показываем только если это НЕ страница входа и НЕ админ *@
        @if (ShowNavigation() && Auth.User?.RoleId != 3)
        {
            <header class="top-nav fade-in-down">
                <div class="nav-content">
                    <div class="brand" @onclick='() => Nav.NavigateTo("/feed")'>
                        <img src="images/logo.png" alt="logo" />
                        <span>МиксМи</span>
                    </div>
                    <nav class="links">
                        <NavLink href="/feed" ActiveClass="active">Лента</NavLink>
                        <NavLink href="/search" ActiveClass="active">Поиск</NavLink>
                        <NavLink href="/rank" ActiveClass="active">Рейтинг</NavLink>

                        <div class="nav-link-wrapper">
                            <NavLink href="/orders" ActiveClass="active">Мои проекты</NavLink>
                            @if (hasNewProjectNotification)
                            {
                                <div class="notification-badge-dot pulse-dot"></div>
                            }
                        </div>
                    </nav>
                    <div class="user-controls">
                        <NotificationBell @ref="notifBell" />
                        <div class="search-trigger" @onclick='() => Nav.NavigateTo("/search")'>
                            <i class="bi bi-search"></i>
                        </div>
                        @if (Auth.IsLoggedIn)
                        {
                            <div class="profile-link" @onclick='() => Nav.NavigateTo("/profile")'>
                                <div class="profile-avatar-container">
                                    @if (string.IsNullOrEmpty(Auth.User?.AvatarUrl))
                                    {
                                        <i class="bi bi-person-fill"></i>
                                    }
                                    else
                                    {
                                        <img src="@GetFullUrl(Auth.User.AvatarUrl)" alt="me" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </header>
        }

        @* 2. КОНТЕНТ: Если админ — растягиваем на весь экран (full-screen) *@
        <main class="content-area @(ShowNavigation() && Auth.User?.RoleId != 3 ? "with-nav" : "full-screen")">
            @Body
        </main>

        @if (!string.IsNullOrEmpty(lastNotification))
        {
            <div class="global-toast animate__animated animate__fadeInRight" @onclick="GoToNotification">
                <div class="toast-icon"><i class="bi bi-chat-fill"></i></div>
                <div class="toast-body">
                    <span class="toast-title">Новое сообщение</span>
                    <p>@lastNotification</p>
                </div>
                <button class="toast-close" @onclick:stopPropagation @onclick="() => lastNotification = null">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }
    }
</div>

<style>
    :root {
        --accent: #E91E63;
        --bg: #0B0B0B;
        --border: rgba(255, 255, 255, 0.15);
    }

    /* ФОН И КРУГИ */
    .bg-visual {
        position: fixed;
        inset: 0;
        z-index: -1;
        background-color: #0B0B0B;
        overflow: hidden;
        pointer-events: none;
    }

    .glow-1 {
        position: absolute;
        top: -10%;
        right: -10%;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(233, 30, 99, 0.25) 0%, transparent 70%);
        filter: blur(80px);
    }

    .glow-2 {
        position: absolute;
        bottom: -5%;
        left: -5%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(233, 30, 99, 0.18) 0%, transparent 70%);
        filter: blur(80px);
    }

    .app-wrapper {
        position: relative;
        width: 100vw;
        height: 100vh;
        background: transparent !important;
        overflow-y: auto;
        overflow-x: hidden;
        z-index: 1;
        color: #ffffff;
    }

    /* УВЕДОМЛЕНИЯ */
    .nav-link-wrapper {
        position: relative !important;
        display: inline-flex !important;
        align-items: center;
        overflow: visible !important;
    }

    .notification-badge-dot {
        position: absolute !important;
        top: -2px !important;
        right: -12px !important;
        width: 10px !important;
        height: 10px !important;
        background-color: #ff4747 !important;
        border-radius: 50% !important;
        z-index: 10005 !important;
        box-shadow: 0 0 12px rgba(255, 71, 71, 0.8) !important;
        border: 1.5px solid #0B0B0B !important;
        display: block !important;
    }

    .pulse-dot {
        animation: pulse-red-nav 2s infinite cubic-bezier(0.4, 0, 0.6, 1) !important;
    }

    @@keyframes pulse-red-nav {
        0% {
            transform: scale(0.9);
            box-shadow: 0 0 0 0 rgba(255, 71, 71, 0.7);
        }

        70% {
            transform: scale(1.4);
            box-shadow: 0 0 0 10px rgba(255, 71, 71, 0);
        }

        100% {
            transform: scale(0.9);
            box-shadow: 0 0 0 0 rgba(255, 71, 71, 0);
        }
    }

    .toast-close {
        background: rgba(255, 255, 255, 0.05); /* Почти прозрачный фон */
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.4); /* Тусклый цвет в обычном состоянии */
        width: 32px;
        height: 32px;
        border-radius: 50%; /* Делаем круглым */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-left: 10px;
        outline: none;
    }

        .toast-close:hover {
            background: #E91E63; /* Твой фирменный розовый при наведении */
            border-color: #E91E63;
            color: white;
            transform: rotate(90deg) scale(1.1); /* Красивый эффект поворота */
        }

        /* Опционально: убери стандартную рамку фокуса в Chrome */
        .toast-close:focus {
            box-shadow: none;
        }

    /* НАВИГАЦИЯ И ВЫРАВНИВАНИЕ */
    .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 70px;
        background: rgba(11, 11, 11, 0.6);
        backdrop-filter: blur(25px);
        border-bottom: 1px solid var(--border);
        z-index: 1000;
        display: flex;
        justify-content: center;
    }

    .nav-content {
        width: 100%;
        max-width: 1400px;
        height: 100%;
        padding: 0 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .user-controls {
        display: flex;
        align-items: center;
        gap: 25px;
        height: 100%;
    }

    .search-trigger {
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.5);
        cursor: pointer;
        font-size: 1.2rem;
        line-height: 1;
    }

    .profile-avatar-container {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: var(--accent);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255,255,255,0.1);
    }

        .profile-avatar-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .content-area.with-nav {
        padding-top: 130px !important;
    }

    .global-toast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid var(--accent);
        border-radius: 22px;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        z-index: 10000;
        cursor: pointer;
    }

    .toast-icon {
        width: 48px;
        height: 48px;
        background: var(--accent);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .links {
        display: flex;
        gap: 40px;
    }

        .links a {
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
        }

            .links a:hover, .links a.active {
                color: white;
            }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
    }

        .brand img {
            height: 32px;
        }

        .brand span {
            font-size: 1.2rem;
            font-weight: 800;
        }
</style>

@code {
    private string BaseApiUrl = "https://localhost:7237";
    private HubConnection? hubConnection;
    private MixMeClient.Components.NotificationBell? notifBell;
    private string? lastNotification;
    private string? lastNotificationOrderId;
    private bool hasNewMessageNotification = false;
    private bool hasNewProjectNotification = false;
    private bool isReady = false;
    

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += HandleLocationChanged;
        Auth.OnLoginStateChanged += async () => await StartGlobalNotificationHub();
        await Auth.InitializeAsync();
        isReady = true;
        if (Auth.IsLoggedIn)
        {
            await StartGlobalNotificationHub();
            CheckAndResetNotifications(Nav.Uri);
        }
    }

    private async Task StartGlobalNotificationHub()
    {
        if (hubConnection != null) return;
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(BaseApiUrl + "/chathub")
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<string, string, string>("ReceiveMessage", async (orderId, user, message) =>
     {
     bool isNotMe = user != Auth.User?.Username;
     bool isNotCurrentPage = !Nav.Uri.Contains($"/order/{orderId}");

     if (isNotMe && isNotCurrentPage)
     {
         lastNotification = $"{user}: {message}";
         lastNotificationOrderId = orderId;
         hasNewMessageNotification = true;
         if (user == "Система" || user == "🤖") hasNewProjectNotification = true;

         if (notifBell != null)
         {
             await notifBell.Refresh();
         }

         await InvokeAsync(StateHasChanged);
     }
     });

            await hubConnection.StartAsync();

            if (Auth.User != null)
            {
                await hubConnection.SendAsync("JoinPersonalGroup", Auth.User.Id.ToString());
                var userOrders = await Http.GetFromJsonAsync<List<MixMeClient.Pages.Orders.OrderViewModel>>(
                    $"{BaseApiUrl}/api/orders/user/{Auth.User.Id}?requesterId={Auth.User.Id}");
                if (userOrders != null)
                {
                    foreach (var order in userOrders) await hubConnection.SendAsync("JoinOrderGroup", order.Id.ToString());
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"SignalR Error: {ex.Message}"); }
    }

    private void CheckAndResetNotifications(string url)
    {
        var relativePath = Nav.ToBaseRelativePath(url).ToLower();
        if (relativePath.Contains("chats")) hasNewMessageNotification = false;
        if (relativePath.Contains("orders") || relativePath.Contains("order/")) hasNewProjectNotification = false;
        StateHasChanged();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => CheckAndResetNotifications(e.Location);

    private void GoToNotification() { if (!string.IsNullOrEmpty(lastNotificationOrderId)) Nav.NavigateTo($"/order/{lastNotificationOrderId}"); lastNotification = null; }

    private bool ShowNavigation()
    {
        // Получаем относительный путь (например, "feed" или "?step=2")
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);

        // Отрезаем параметры запроса, чтобы получить только чистый путь
        // Разделяем строку по знаку '?' и берем первую часть
        var pathOnly = relativePath.Split('?')[0].ToLower();

        // Панель скрыта, если:
        // 1. Путь пустой (главная страница лендинга)
        // 2. Путь содержит "login"
        // 3. Путь содержит "register"
        return !(string.IsNullOrEmpty(pathOnly) ||
                 pathOnly.Contains("login") ||
                 pathOnly.Contains("register"));
    }

    private string GetFullUrl(string? url) => string.IsNullOrEmpty(url) ? "" : (url.StartsWith("http") ? url : $"{BaseApiUrl}/{url.TrimStart('/')}");

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        Auth.OnLoginStateChanged -= async () => await StartGlobalNotificationHub(); // ОТПИСКА
        if (hubConnection != null) await hubConnection.DisposeAsync();
    }
}