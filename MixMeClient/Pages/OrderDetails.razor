@page "/order/{OrderId:guid}"
@using Microsoft.AspNetCore.SignalR.Client
@using MixMeShared
@using System.Globalization
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<BackgroundGlow />

<div class="order-details-layout">

    @* --- БЛОК ОШИБОК --- *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="container mt-4">
            <div class="alert alert-danger d-flex align-items-center animate__animated animate__fadeIn" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>@errorMessage</div>
                <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
            </div>
        </div>
    }

    @if (isInitialLoading)
    {
        <div class="loader-box">
            <div class="spinner-premium"></div>
            <p>Синхронизация данных проекта...</p>
        </div>
    }
    else if (order != null)
    {
        <div class="details-grid animate__animated animate__fadeIn">

            @* --- ЛЕВАЯ КОЛОНКА: СТАТУС, ФАЙЛЫ И ОТЗЫВ --- *@
            <section class="info-panel">

                @* КАРТОЧКА СТАТУСА *@
                <div class="glass-box status-card">
                    <div class="status-header">
                        <span class="badge-status @order.Status.ToLower()">@TranslateStatus(order.Status)</span>
                        <h3>@order.ServiceName</h3>
                    </div>
                    <div class="workflow-steps">
                        <div class="step @GetStepClass(1)"><span>1</span><p>Оплата</p></div>
                        <div class="step @GetStepClass(2)"><span>2</span><p>В работе</p></div>
                        <div class="step @GetStepClass(3)"><span>3</span><p>Проверка</p></div>
                        <div class="step @GetStepClass(4)"><span>4</span><p>Готово</p></div>
                    </div>
                </div>

                @* ВИДЖЕТ ФАЙЛОВ *@
                <div class="glass-box files-widget">
                    <h4><i class="bi bi-folder2-open me-2"></i> Файлы проекта</h4>

                    <div class="file-list scroll-styled" id="fileListContainer">
                        @if (orderFiles == null || !orderFiles.Any())
                        {
                            <div class="empty-files-note">
                                <i class="bi bi-cloud-slash mb-2"></i>
                                <p>Файлов пока нет</p>
                            </div>
                        }
                        else
                        {
                            <h6 class="file-section-label">Исходники (Stems)</h6>
                            @foreach (var file in orderFiles.Where(f => f.FileType == "Stems"))
                            {
                                <div class="file-item customer-file">
                                    <i class="bi bi-music-note-list"></i> @* Изменил иконку на музыкальную *@
                                    <div class="f-info">
                                        <span>@file.FileName</span>
                                        <p>Загружено заказчиком</p>
                                    </div>
                                    <div class="file-actions d-flex gap-2">
                                        <a href="@GetFullUrl(file.FileUrl)" target="_blank" class="btn-download"><i class="bi bi-download"></i></a>
                                        @if (Auth.User?.Id == file.UploaderId) @* Удалить может только тот, кто загрузил *@
                                        {
                                            <button class="btn-del-file-mini" @onclick="() => DeleteFile(file.Id)"><i class="bi bi-trash3"></i></button>
                                        }
                                    </div>
                                </div>
                            }

                            <h6 class="file-section-label mt-4">Результат (Mix/Master)</h6>
                            @foreach (var file in orderFiles.Where(f => f.FileType == "Result"))
                            {
                                <div class="file-item engineer-file">
                                    <i class="bi bi-music-note-beamed"></i>
                                    <div class="f-info">
                                        <span>@file.FileName</span>
                                        <p>Загружено инженером</p>
                                    </div>
                                    <a href="@GetFullUrl(file.FileUrl)" target="_blank" class="btn-download"><i class="bi bi-download"></i></a>
                                </div>
                            }
                        }
                    </div>

                    @if (order.Status != "Completed")
                    {
                        <label class="btn-upload-result w-100 mt-3 text-center @(isUploading ? "disabled" : "")">
                            @if (isUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>Загрузка...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-upload me-2"></i>
                                <span>@(Auth.User?.RoleId == 1 ? "Загрузить дорожки" : "Загрузить результат")</span>
                            }
                            <InputFile OnChange="UploadOrderFile" hidden disabled="@isUploading" accept="audio/*" />
                        </label>
                    }
                </div>

                @* УПРАВЛЕНИЕ ЗАКАЗОМ *@
                @* --- УПРАВЛЕНИЕ ЗАКАЗОМ --- *@
                @* --- УПРАВЛЕНИЕ ЗАКАЗОМ --- *@
                @* --- УПРАВЛЕНИЕ ЗАКАЗОМ (Умная логика статусов) --- *@
                <div class="actions-zone mt-3">

                    @* --- ЭТАП 1: ОЖИДАНИЕ ПОДТВЕРЖДЕНИЯ (Пре-модерация) --- *@
                    @if (order.Status == "WaitingForConfirmation")
                    {
                        @if (Auth.User?.RoleId == 2) @* Видит Инженер *@
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-success w-50" @onclick="AcceptOrder" style="border-radius:15px; font-weight:700; background:#4CAF50; border:none; padding: 15px;">
                                    <i class="bi bi-check-lg"></i> Принять работу
                                </button>
                                <button class="btn-danger-modern w-50" @onclick='() => HandleDecline("инженер")'>
                                    <i class="bi bi-x-lg"></i> Отклонить
                                </button>
                            </div>
                            <p class="text-muted small mt-2 text-center"><i class="bi bi-info-circle"></i> Заказчик сможет оплатить только после вашего подтверждения.</p>
                        }
                        else @* Видит Заказчик *@
                        {
                            <div class="alert alert-warning" style="border-radius:18px; background: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.2); color: #ffc107; padding:15px;">
                                <i class="bi bi-hourglass-split me-2"></i> Проект на рассмотрении. Ожидайте подтверждения от инженера.
                            </div>
                            <button class="btn-danger-modern w-100" @onclick='() => HandleDecline("заказчик")'>
                                <i class="bi bi-trash3 me-2"></i> Отменить запрос
                            </button>
                        }
                    }

                    @* --- ЭТАП 2: ОЖИДАНИЕ ОПЛАТЫ (После подтверждения) --- *@
                    @if (order.Status == "WaitingForPayment")
                    {
                        @if (Auth.User?.RoleId == 1) @* Видит Заказчик *@
                        {
                            <button class="btn-pay-now w-100 mb-2" @onclick="GoToPayment">
                                Оплатить и начать проект (@order.TotalAmount.ToString("N0") ₽) <i class="bi bi-credit-card-2-back ms-2"></i>
                            </button>

                            @if (!string.IsNullOrEmpty(order.PaymentId))
                            {
                                <div class="alert alert-info mt-2 mb-3 p-3" style="border-radius: 18px; background: rgba(0, 188, 212, 0.1); border: 1px solid rgba(0, 188, 212, 0.2); color: #00bcd4;">
                                    <small class="d-block mb-2"><i class="bi bi-info-circle me-1"></i> Оплатили, но статус не изменился?</small>
                                    <button class="btn btn-sm btn-info w-100" style="color: white; font-weight: 700; border-radius: 10px;" @onclick="CheckStatus">
                                        <i class="bi bi-arrow-repeat me-1"></i> Проверить статус оплаты
                                    </button>
                                </div>
                            }

                            <button class="btn-danger-modern w-100" @onclick='() => HandleDecline("заказчик")'>
                                <i class="bi bi-trash3 me-2"></i> Отменить и закрыть проект
                            </button>
                        }
                        else @* Видит Инженер *@
                        {
                            <div class="alert alert-info" style="border-radius:18px; background: rgba(0, 188, 212, 0.1); border: 1px solid rgba(0, 188, 212, 0.2); color: #00bcd4; padding:20px;">
                                <i class="bi bi-check2-circle me-2"></i> Вы подтвердили готовность. Ожидайте оплаты от клиента.
                            </div>
                            <button class="btn-danger-modern w-100" @onclick='() => HandleDecline("инженер")'>
                                <i class="bi bi-x-circle me-2"></i> Отказываюсь работать
                            </button>
                        }
                    }

                    @* --- ЭТАП 3: УПРАВЛЕНИЕ АКТИВНЫМ ПРОЕКТОМ (В РАБОТЕ / НА ПРОВЕРКЕ) --- *@
                    @if (order.Status == "InProgress" || order.Status == "UnderReview")
                    {
                        @* 1. Кнопка "Принять" — видит только Заказчик и только если результат загружен *@
                        @if (Auth.User?.RoleId == 1 && order.Status == "UnderReview")
                        {
                            <button class="btn-accept-work w-100 mb-2" @onclick="AcceptWork">
                                <i class="bi bi-check-circle-fill me-2"></i> Принять готовую работу
                            </button>
                        }

                        @* 2. Кнопка "Спор" — видят ОБА (и Заказчик, и Инженер) на любом активном этапе *@
                        @if (Auth.User?.RoleId == 1 || Auth.User?.RoleId == 2)
                        {
                            <button class="btn-danger-modern w-100" @onclick="OpenDispute" style="background: rgba(220, 53, 69, 0.05) !important;">
                                <i class="bi bi-shield-exclamation me-2"></i> Привлечь арбитраж (Спор)
                            </button>
                        }
                    }

                    @* --- ЭТАП 4: СОСТОЯНИЕ СПОРА (Видят оба участника, когда модератор уже в деле) --- *@
                    @if (order.Status == "Disputed")
                    {
                        <div class="alert mt-3 animate__animated animate__pulse"
                             style="border-radius: 20px; background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.2); color: #ff8585; padding: 20px;">
                            <h5 class="alert-heading d-flex align-items-center gap-2" style="font-weight: 800;">
                                <i class="bi bi-shield-fill-exclamation"></i> Идет разбирательство (Спор)
                            </h5>
                            <p class="small mb-0" style="opacity: 0.8;">
                                Модератор-арбитр подключен к проекту. Он изучит финальный файл, исходники и переписку в чате.
                                Ожидайте вердикта, кнопки управления заблокированы.
                            </p>
                        </div>
                    }
                </div>

                @* ФОРМА ОТЗЫВА (ТОЛЬКО ДЛЯ ЗАКАЗЧИКА ПРИ ЗАВЕРШЕНИИ) *@
                @if (order.Status == "Completed" && Auth.User?.RoleId == 1 && !isReviewSubmitted)
                {
                    <div class="glass-box mt-4 review-form-box">
                        <h4 style="color: var(--pink); font-weight: 800;">
                            <i class="bi bi-star-fill me-2"></i> Оцените работу мастера
                        </h4>
                        <p class="small" style="color: rgba(255,255,255,0.5);">
                            Ваш отзыв поможет другим пользователям выбрать лучшего специалиста.
                        </p>

                        <div class="rating-stars-container">
                            @for (int i = 1; i <= 5; i++)
                            {
                                int starRating = i;
                                <i class="bi @(reviewRating >= starRating ? "bi-star-fill" : "bi-star")"
                                   style="color: @(reviewRating >= starRating ? "#FFC107" : "rgba(255,255,255,0.1)");"
                                   @onclick="() => reviewRating = starRating"></i>
                            }
                        </div>

                        <textarea class="review-textarea mb-3"
                                  rows="3"
                                  @bind="reviewComment"
                                  placeholder="Что вам понравилось в работе? Напишите ваш отзыв здесь..."></textarea>

                        <button class="btn-save-pro w-100" @onclick="SubmitReview" disabled="@(reviewRating == 0 || isSavingReview)">
                            @if (isSavingReview)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Отправка...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-check-fill me-2"></i>
                                <span>Опубликовать отзыв</span>
                            }
                        </button>
                    </div>
                }

            </section>

            @* --- ПРАВАЯ КОЛОНКА: ЧАТ --- *@
            <section class="chat-panel glass-box">
                <div class="chat-header">
                    @* Кликабельная зона для перехода в профиль *@
                    <div class="d-flex align-items-center gap-3" @onclick="GoToPartnerProfile" style="cursor: pointer;">
                        <div class="chat-ava-mini">
                            @if (string.IsNullOrEmpty(order.PartnerAvatar))
                            {
                                <i class="bi bi-person-circle"></i>
                            }
                            else
                            {
                                <img src="@GetFullUrl(order.PartnerAvatar)"
                                     style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" />
                            }
                        </div>
                        <div>
                            <div class="chat-with-label">Проектный чат</div>
                            <div class="chat-partner-name">@order.PartnerName</div>
                        </div>
                    </div>
                </div>

                <div class="messages-area scroll-styled" id="msgContainer">
                    @if (chatMessages.Count == 0)
                    {
                        <div class="chat-start-hint"><i class="bi bi-chat-dots"></i><p>Начните обсуждение проекта здесь</p></div>
                    }
                    else
                    {
                        @foreach (var msg in chatMessages)
                        {
                            var bubbleClass = msg.User == "Система" ? "system" : (msg.User == Auth.User?.Username ? "me" : "partner");

                            <div class="message-bubble @bubbleClass">
                                <div class="msg-author">
                                    @if (msg.User == "Система")
                                    {
                                        <i class="bi bi-robot me-2"></i>
                                    }
                                    @msg.User
                                </div>
                                <div class="msg-content">@msg.Text</div>
                                @if (msg.User != "Система")
                                {
                                    <div class="msg-time">@msg.Time.ToString("HH:mm")</div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="chat-input-zone">
                    @* Добавляем @bind:event="oninput", чтобы переменная обновлялась мгновенно *@
                    <textarea @bind="newMessage"
                              @bind:event="oninput"
                              @onkeyup="HandleKeyPress"
                              disabled="@(order?.Status == "Disputed")"
                              placeholder="@(order?.Status == "Disputed" ? "Чат заморожен модератором..." : "Введите сообщение...")"></textarea>

                    <button class="btn-send" @onclick="SendMessage"
                            disabled="@(hubConnection?.State != HubConnectionState.Connected || string.IsNullOrWhiteSpace(newMessage) || order?.Status == "Disputed")">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </section>
        </div>
    }
</div>

<style>
    .order-details-layout {
        position: fixed;
        inset: 70px 0 0 0;
        padding: 20px 5%;
        overflow: hidden; /* Убираем общий скролл страницы */
        display: flex;
        justify-content: center;
    }

    /* 2. Сетка занимает всю доступную высоту */
    .details-grid {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 30px;
        width: 100%;
        max-width: 1400px;
        height: calc(100vh - 110px); /* Высота за вычетом отступов */
    }


    .glass-box {
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(25px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 28px;
    padding: 25px;
    }

    /* Стили файлов */
    .file-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px;
    background: rgba(255,255,255,0.03);
    border-radius: 15px;
    margin-bottom: 10px;
    }

    .file-item i {
    font-size: 1.5rem;
    color: #E91E63;
    }

    .f-info span {
    display: block;
    font-weight: 700;
    font-size: 0.85rem;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    }

    .f-info p {
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
    }

    .btn-download {
    color: white;
    opacity: 0.5;
    transition: 0.3s;
    }

    .btn-download:hover {
    opacity: 1;
    color: #E91E63;
    }

    /* Чат */
    .info-panel {
        overflow-y: auto;
        padding-right: 10px;
        height: 100%;
    }

    /* 4. Чат-панель превращается в гибкий контейнер */
    .chat-panel {
        display: flex;
        flex-direction: column;
        height: 100%; /* Важно! */
        padding: 0;
        overflow: hidden;
    }

    .chat-header {
        flex-shrink: 0; /* Шапка не сжимается */
        padding: 20px 30px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .chat-with-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    font-weight: 800;
    }

    .chat-partner-name {
    font-weight: 800;
    font-size: 1.1rem;
    }

    .messages-area {
        flex-grow: 1; /* Занимает всё свободное место между шапкой и вводом */
        overflow-y: auto;
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .message-bubble {
    max-width: 75%;
    padding: 12px 18px;
    border-radius: 20px;
    position: relative;
    }

    .message-bubble.me {
    align-self: flex-end;
    background: #E91E63;
    color: white;
    border-bottom-right-radius: 4px;
    }

    .message-bubble.partner {
    align-self: flex-start;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-bottom-left-radius: 4px;
    }

    .msg-author {
    font-size: 0.65rem;
    font-weight: 900;
    margin-bottom: 4px;
    opacity: 0.7;
    text-transform: uppercase;
    }

    .msg-time {
    font-size: 0.6rem;
    opacity: 0.5;
    text-align: right;
    margin-top: 4px;
    }

    .chat-input-zone {
        flex-shrink: 0;
        padding: 20px 30px;
        background: rgba(0,0,0,0.3);
        display: flex; /* Обязательно */
        gap: 15px;
        align-items: center;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

        .chat-input-zone textarea {
            flex-grow: 1;
            background: rgba(255,255,255,0.05) !important;
            border: 1px solid rgba(255,255,255,0.1) !important;
            border-radius: 18px !important;
            color: white !important;
            padding: 14px 20px !important;
            height: 54px !important; /* Фиксированная высота для аккуратности */
            min-height: 54px;
            max-height: 150px;
            resize: none !important;
            outline: none !important;
            font-size: 0.95rem;
            transition: 0.2s;
        }

            .chat-input-zone textarea:focus {
                border-color: #E91E63 !important;
                background: rgba(255,255,255,0.08) !important;
            }

    .btn-send {
        width: 54px;
        height: 54px;
        background: #E91E63; /* Яркий розовый */
        color: white;
        border: none;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(233, 30, 99, 0.3);
    }


        .btn-send:disabled {
            background: #444 !important; /* Серый фон */
            opacity: 0.4;
            cursor: not-allowed;
            box-shadow: none;
            transform: none !important;
        }

        /* Эффект при наведении только на активную кнопку */
        .btn-send:hover:not(:disabled) {
            background: #ff2e75;
            transform: scale(1.05);
            box-shadow: 0 8px 20px rgba(233, 30, 99, 0.4);
        }

    /* Кнопки */
    .btn-pay-now {
    background: #4CAF50;
    color: white;
    border: none;
    padding: 15px;
    border-radius: 15px;
    font-weight: 800;
    box-shadow: 0 10px 20px rgba(76, 175, 80, 0.2);
    }

    .btn-accept-work {
    background: #00bcd4;
    color: white;
    border: none;
    padding: 15px;
    border-radius: 15px;
    font-weight: 800;
    }

    .btn-upload-result {
    background: rgba(233, 30, 99, 0.1);
    border: 1px dashed #E91E63;
    color: #E91E63;
    padding: 12px;
    border-radius: 15px;
    font-weight: 700;
    }

    /* Workflow */
    .workflow-steps {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
    position: relative;
    }

    .workflow-steps::before {
    content: '';
    position: absolute;
    top: 15px;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255,255,255,0.05);
    }

    .step {
    position: relative;
    z-index: 1;
    text-align: center;
    opacity: 0.2;
    transition: 0.5s;
    }

    .step.active {
    opacity: 1;
    }

    .step span {
    width: 32px;
    height: 32px;
    background: #111;
    border: 2px solid white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px;
    font-weight: 800;
    }

    .step.active span {
    background: #E91E63;
    border-color: #E91E63;
    box-shadow: 0 0 15px #E91E63;
    }

    .step p {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    }

    .badge-status {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: inline-block;
    }

    .badge-status.waitingforpayment {
    background: #FFC107;
    color: black;
    }

    .badge-status.inprogress {
    background: #E91E63;
    color: white;
    }

    .badge-status.underreview {
    background: #00bcd4;
    color: white;
    }

    .badge-status.completed {
    background: #4CAF50;
