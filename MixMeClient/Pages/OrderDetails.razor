@page "/order/{OrderId:guid}"
@using Microsoft.AspNetCore.SignalR.Client
@using MixMeShared
@using System.Globalization
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<BackgroundGlow />

<div class="order-details-layout">

    @* --- БЛОК ОШИБОК --- *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="container mt-4">
            <div class="alert alert-danger d-flex align-items-center animate__animated animate__fadeIn" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>@errorMessage</div>
                <button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = null"></button>
            </div>
        </div>
    }

    @if (isInitialLoading)
    {
        <div class="loader-box">
            <div class="spinner-premium"></div>
            <p>Синхронизация данных проекта...</p>
        </div>
    }
    else if (order != null)
    {
        <div class="details-grid animate__animated animate__fadeIn">

            @* --- ЛЕВАЯ КОЛОНКА: СТАТУС, ФАЙЛЫ И ОТЗЫВ --- *@
            <section class="info-panel">

                @* КАРТОЧКА СТАТУСА *@
                <div class="glass-box status-card">
                    <div class="status-header">
                        <span class="badge-status @order.Status.ToLower()">@TranslateStatus(order.Status)</span>
                        <h3>@order.ServiceName</h3>
                    </div>
                    <div class="workflow-steps">
                        <div class="step @GetStepClass(1)"><span>1</span><p>Оплата</p></div>
                        <div class="step @GetStepClass(2)"><span>2</span><p>В работе</p></div>
                        <div class="step @GetStepClass(3)"><span>3</span><p>Проверка</p></div>
                        <div class="step @GetStepClass(4)"><span>4</span><p>Готово</p></div>
                    </div>
                </div>

                @* ВИДЖЕТ ФАЙЛОВ *@
                <div class="glass-box files-widget">
                    <h4><i class="bi bi-folder2-open me-2"></i> Файлы проекта</h4>

                    <div class="file-list scroll-styled" id="fileListContainer">
                        @if (orderFiles == null || !orderFiles.Any())
                        {
                            <div class="empty-files-note">
                                <i class="bi bi-cloud-slash mb-2"></i>
                                <p>Файлов пока нет</p>
                            </div>
                        }
                        else
                        {
                            <h6 class="file-section-label">Исходники (Stems)</h6>
                            @foreach (var file in orderFiles.Where(f => f.FileType == "Stems"))
                            {
                                <div class="file-item customer-file">
                                    <i class="bi bi-music-note-list"></i> @* Изменил иконку на музыкальную *@
                                    <div class="f-info">
                                        <span>@file.FileName</span>
                                        <p>Загружено заказчиком</p>
                                    </div>
                                    <div class="file-actions d-flex gap-2">
                                        <a href="@GetFullUrl(file.FileUrl)" target="_blank" class="btn-download"><i class="bi bi-download"></i></a>
                                        @if (Auth.User?.Id == file.UploaderId) @* Удалить может только тот, кто загрузил *@
                                        {
                                            <button class="btn-del-file-mini" @onclick="() => DeleteFile(file.Id)"><i class="bi bi-trash3"></i></button>
                                        }
                                    </div>
                                </div>
                            }

                            <h6 class="file-section-label mt-4">Результат (Mix/Master)</h6>
                            @foreach (var file in orderFiles.Where(f => f.FileType == "Result"))
                            {
                                <div class="file-item engineer-file">
                                    <i class="bi bi-music-note-beamed"></i>
                                    <div class="f-info">
                                        <span>@file.FileName</span>
                                        <p>Загружено инженером</p>
                                    </div>
                                    <a href="@GetFullUrl(file.FileUrl)" target="_blank" class="btn-download"><i class="bi bi-download"></i></a>
                                </div>
                            }
                        }
                    </div>

                    @if (order.Status != "Completed")
                    {
                        <label class="btn-upload-result w-100 mt-3 text-center @(isUploading ? "disabled" : "")">
                            @if (isUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>Загрузка...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-upload me-2"></i>
                                <span>@(Auth.User?.RoleId == 1 ? "Загрузить дорожки" : "Загрузить результат")</span>
                            }
                            <InputFile OnChange="UploadOrderFile" hidden disabled="@isUploading" accept="audio/*" />
                        </label>
                    }
                </div>

                @* УПРАВЛЕНИЕ ЗАКАЗОМ *@
                <div class="actions-zone mt-3">
                    @if (Auth.User?.RoleId == 1 && order.Status == "WaitingForPayment")
                    {
                        <button class="btn-pay-now w-100" @onclick="GoToPayment">
                            Оплатить @order.TotalAmount.ToString("N0") ₽ <i class="bi bi-credit-card-2-back ms-2"></i>
                        </button>

                        @if (!string.IsNullOrEmpty(order.PaymentId))
                        {
                            <div class="alert alert-info mt-3 p-3" style="border-radius: 18px; background: rgba(0, 188, 212, 0.1); border: 1px solid rgba(0, 188, 212, 0.2); color: #00bcd4;">
                                <small class="d-block mb-2"><i class="bi bi-info-circle me-1"></i> Оплатили, но статус не изменился?</small>
                                <button class="btn btn-sm btn-info w-100" style="color: white; font-weight: 700; border-radius: 10px;" @onclick="CheckStatus">
                                    <i class="bi bi-arrow-repeat me-1"></i> Проверить оплату
                                </button>
                            </div>
                        }
                    }

                    @if (Auth.User?.RoleId == 1 && order.Status == "UnderReview")
                    {
                        <button class="btn-accept-work w-100" @onclick="AcceptWork">
                            <i class="bi bi-check-circle-fill me-2"></i> Принять работу
                        </button>
                    }
                </div>

                @* ФОРМА ОТЗЫВА (ТОЛЬКО ДЛЯ ЗАКАЗЧИКА ПРИ ЗАВЕРШЕНИИ) *@
                @if (order.Status == "Completed" && Auth.User?.RoleId == 1 && !isReviewSubmitted)
                {
                    <div class="glass-box mt-4 review-form-box">
                        <h4 style="color: var(--pink); font-weight: 800;">
                            <i class="bi bi-star-fill me-2"></i> Оцените работу мастера
                        </h4>
                        <p class="small" style="color: rgba(255,255,255,0.5);">
                            Ваш отзыв поможет другим пользователям выбрать лучшего специалиста.
                        </p>

                        <div class="rating-stars-container">
                            @for (int i = 1; i <= 5; i++)
                            {
                                int starRating = i;
                                <i class="bi @(reviewRating >= starRating ? "bi-star-fill" : "bi-star")"
                                   style="color: @(reviewRating >= starRating ? "#FFC107" : "rgba(255,255,255,0.1)");"
                                   @onclick="() => reviewRating = starRating"></i>
                            }
                        </div>

                        <textarea class="review-textarea mb-3"
                                  rows="3"
                                  @bind="reviewComment"
                                  placeholder="Что вам понравилось в работе? Напишите ваш отзыв здесь..."></textarea>

                        <button class="btn-save-pro w-100" @onclick="SubmitReview" disabled="@(reviewRating == 0 || isSavingReview)">
                            @if (isSavingReview)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Отправка...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-check-fill me-2"></i>
                                <span>Опубликовать отзыв</span>
                            }
                        </button>
                    </div>
                }

            </section>

            @* --- ПРАВАЯ КОЛОНКА: ЧАТ --- *@
            <section class="chat-panel glass-box">
                <div class="chat-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="chat-ava-mini"><i class="bi bi-person-circle"></i></div>
                        <div>
                            <div class="chat-with-label">Проектный чат</div>
                            <div class="chat-partner-name">@order.PartnerName</div>
                        </div>
                    </div>
                </div>

                <div class="messages-area scroll-styled" id="msgContainer">
                    @if (chatMessages.Count == 0)
                    {
                        <div class="chat-start-hint"><i class="bi bi-chat-dots"></i><p>Начните обсуждение проекта здесь</p></div>
                    }
                    else
                    {
                        @foreach (var msg in chatMessages)
                        {
                            var bubbleClass = msg.User == "Система" ? "system" : (msg.User == Auth.User?.Username ? "me" : "partner");

                            <div class="message-bubble @bubbleClass">
                                <div class="msg-author">
                                    @if (msg.User == "Система")
                                    {
                                        <i class="bi bi-robot me-2"></i>
                                    }
                                    @msg.User
                                </div>
                                <div class="msg-content">@msg.Text</div>
                                @if (msg.User != "Система")
                                {
                                    <div class="msg-time">@msg.Time.ToString("HH:mm")</div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="chat-input-zone">
                    <textarea @bind="newMessage" @onkeyup="HandleKeyPress" placeholder="Введите сообщение..."></textarea>
                    <button class="btn-send" @onclick="SendMessage"
                            disabled="@(hubConnection?.State != HubConnectionState.Connected || string.IsNullOrWhiteSpace(newMessage))">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </section>
        </div>
    }
</div>

<style>
    .order-details-layout {
        position: fixed;
        inset: 70px 0 0 0;
        padding: 40px 5%;
        overflow-y: auto; /* ЗАМЕНИТЬ hidden на auto */
    }

    .details-grid {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 30px;
        /* УДАЛИТЬ height: 100% */
        height: auto;
        max-width: 1400px;
        margin: 0 auto;
        padding-bottom: 50px; /* Чтобы футер не прилипал к низу */
    }

    .glass-box {
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(25px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 28px;
    padding: 25px;
    }

    /* Стили файлов */
    .file-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px;
    background: rgba(255,255,255,0.03);
    border-radius: 15px;
    margin-bottom: 10px;
    }

    .file-item i {
    font-size: 1.5rem;
    color: #E91E63;
    }

    .f-info span {
    display: block;
    font-weight: 700;
    font-size: 0.85rem;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    }

    .f-info p {
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
    }

    .btn-download {
    color: white;
    opacity: 0.5;
    transition: 0.3s;
    }

    .btn-download:hover {
    opacity: 1;
    color: #E91E63;
    }

    /* Чат */
    .chat-panel {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    }

    .chat-header {
    padding: 20px 30px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .chat-with-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    font-weight: 800;
    }

    .chat-partner-name {
    font-weight: 800;
    font-size: 1.1rem;
    }

    .messages-area {
    flex-grow: 1;
    overflow-y: auto;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    }

    .message-bubble {
    max-width: 75%;
    padding: 12px 18px;
    border-radius: 20px;
    position: relative;
    }

    .message-bubble.me {
    align-self: flex-end;
    background: #E91E63;
    color: white;
    border-bottom-right-radius: 4px;
    }

    .message-bubble.partner {
    align-self: flex-start;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-bottom-left-radius: 4px;
    }

    .msg-author {
    font-size: 0.65rem;
    font-weight: 900;
    margin-bottom: 4px;
    opacity: 0.7;
    text-transform: uppercase;
    }

    .msg-time {
    font-size: 0.6rem;
    opacity: 0.5;
    text-align: right;
    margin-top: 4px;
    }

    .chat-input-zone {
    padding: 20px;
    background: rgba(0,0,0,0.2);
    display: flex;
    gap: 15px;
    }

    .chat-input-zone textarea {
    flex-grow: 1;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 15px;
    color: white;
    padding: 12px;
    resize: none;
    height: 50px;
    outline: none;
    }

    .btn-send {
    background: #E91E63;
    color: white;
    border: none;
    width: 50px;
    border-radius: 15px;
    }

    /* Кнопки */
    .btn-pay-now {
    background: #4CAF50;
    color: white;
    border: none;
    padding: 15px;
    border-radius: 15px;
    font-weight: 800;
    box-shadow: 0 10px 20px rgba(76, 175, 80, 0.2);
    }

    .btn-accept-work {
    background: #00bcd4;
    color: white;
    border: none;
    padding: 15px;
    border-radius: 15px;
    font-weight: 800;
    }

    .btn-upload-result {
    background: rgba(233, 30, 99, 0.1);
    border: 1px dashed #E91E63;
    color: #E91E63;
    padding: 12px;
    border-radius: 15px;
    font-weight: 700;
    }

    /* Workflow */
    .workflow-steps {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
    position: relative;
    }

    .workflow-steps::before {
    content: '';
    position: absolute;
    top: 15px;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255,255,255,0.05);
    }

    .step {
    position: relative;
    z-index: 1;
    text-align: center;
    opacity: 0.2;
    transition: 0.5s;
    }

    .step.active {
    opacity: 1;
    }

    .step span {
    width: 32px;
    height: 32px;
    background: #111;
    border: 2px solid white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px;
    font-weight: 800;
    }

    .step.active span {
    background: #E91E63;
    border-color: #E91E63;
    box-shadow: 0 0 15px #E91E63;
    }

    .step p {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    }

    .badge-status {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: inline-block;
    }

    .badge-status.waitingforpayment {
    background: #FFC107;
    color: black;
    }

    .badge-status.inprogress {
    background: #E91E63;
    color: white;
    }

    .badge-status.underreview {
    background: #00bcd4;
    color: white;
    }

    .badge-status.completed {
    background: #4CAF50;
    color: white;
    }
    /* Специальный стиль для системных сообщений */
    .message-bubble.system {
        align-self: center; /* Центрируем */
        background: rgba(255, 255, 255, 0.05); /* Делаем полупрозрачным */
        border: 1px dashed rgba(255, 255, 255, 0.2); /* Пунктирная рамка */
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.85rem;
        text-align: center;
        border-radius: 12px;
        padding: 8px 15px;
        margin: 10px 0;
    }

        .message-bubble.system .msg-author {
            color: #E91E63; /* Розовый акцент для имени бота */
            justify-content: center;
            display: flex;
        }

        .message-bubble.system .msg-time {
            display: none; /* Прячем время для системных уведомлений, если нужно */
        }

    .experience-tag {
        background: rgba(255, 255, 255, 0.05);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .item-main-info h4 {
        margin-bottom: 2px;
    }

    .file-section-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: var(--pink);
        letter-spacing: 1px;
        margin-bottom: 10px;
        opacity: 0.8;
    }

    .file-item.engineer-file {
        border-left: 3px solid #00bcd4; /* Голубой для результата */
    }

    .file-item.customer-file {
        border-left: 3px solid #E91E63; /* Розовый для исходников */
    }
    /* Стили для системы рейтинга (звезды) */
    .rating-stars-container {
        display: flex;
        gap: 10px;
        margin: 15px 0;
    }

        .rating-stars-container i {
            font-size: 2rem;
            cursor: pointer;
            transition: transform 0.2s, color 0.2s;
        }

            /* Эффект увеличения звезды при наведении */
            .rating-stars-container i:hover {
                transform: scale(1.2);
            }

    /* Особый стиль для текстового поля отзыва */
    .review-textarea {
        width: 100%;
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 15px !important;
        color: white !important;
        padding: 15px !important;
        font-size: 0.95rem;
        outline: none !important;
        resize: none;
        transition: 0.3s;
    }

        .review-textarea:focus {
            border-color: var(--pink) !important;
            background: rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 0 15px rgba(233, 30, 99, 0.1);
        }

        /* Стилизация placeholder (текста-подсказки) */
        .review-textarea::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }
    /* Стиль для кнопки публикации отзыва */
    .btn-save-pro {
        background: linear-gradient(135deg, #E91E63 0%, #ff2e75 100%);
        color: white;
        border: none;
        padding: 16px 30px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 20px rgba(233, 30, 99, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        /* Эффект при наведении */
        .btn-save-pro:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 30px rgba(233, 30, 99, 0.5);
            filter: brightness(1.1);
        }

        /* Эффект при клике */
        .btn-save-pro:active:not(:disabled) {
            transform: translateY(-1px) scale(1);
        }

        /* Состояние, когда кнопка отключена (если не выбраны звезды) */
        .btn-save-pro:disabled {
            background: #444;
            color: rgba(255, 255, 255, 0.3);
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        /* Иконка внутри кнопки */
        .btn-save-pro i {
            font-size: 1.2rem;
        }

    /* Анимация для появления блока (если не установлена библиотека Animate.css) */
    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .review-form-box {
        animation: fadeInUp 0.5s ease-out;
        border: 1px solid rgba(233, 30, 99, 0.3) !important; /* Легкое розовое свечение границ */
    }

    .btn-del-file-mini {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: 0.2s;
        font-size: 1rem;
        padding: 0 5px;
    }

        .btn-del-file-mini:hover {
            color: #ff5252;
            transform: scale(1.2);
        }

    .file-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
    }
</style>

@code {
    [Parameter] public Guid OrderId { get; set; }
    private HubConnection? hubConnection;
    private List<ChatMessage> chatMessages = new();
    private List<OrderFile> orderFiles = new();
    private string newMessage = "";
    private OrderDetailViewModel? order;
    private bool isUploading = false;
    private bool isInitialLoading = true;
    private string? errorMessage;
    private string BaseApiUrl = "https://localhost:7237";

    // ПЕРЕМЕННЫЕ ДЛЯ ОТЗЫВА
    private int reviewRating = 0;
    private string reviewComment = "";
    private bool isReviewSubmitted = false;
    private bool isSavingReview = false;

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(150);
            await JS.InvokeVoidAsync("scrollToBottom", "msgContainer");
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка скролла: {ex.Message}"); }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(BaseApiUrl + "/chathub")
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<string, string, string>("ReceiveMessage", async (orderId, user, message) =>
            {
                if (user != Auth.User?.Username)
                {
                    chatMessages.Add(new ChatMessage { User = user, Text = message });
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottom();
                }
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Не удалось установить соединение с чат-сервером.";
            Console.WriteLine($"SignalR Error: {ex.Message}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId != Guid.Empty)
        {
            isInitialLoading = true;
            errorMessage = null;
            await LoadAllData();
            isInitialLoading = false;
        }
    }

    private async Task LoadAllData()
    {
        try
        {
            // 1. Загружаем основные данные заказа
            var response = await Http.GetAsync($"{BaseApiUrl}/api/orders/{OrderId}?currentUserId={Auth.User.Id}");

            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await JS.InvokeVoidAsync("alert", "Доступ запрещен! Вы не являетесь участником этого проекта.");
                Nav.NavigateTo("/feed");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                order = await response.Content.ReadFromJsonAsync<OrderDetailViewModel>();

                if (order != null)
                {
                    // 2. Загружаем файлы проекта
                    orderFiles = await Http.GetFromJsonAsync<List<OrderFile>>($"{BaseApiUrl}/api/OrderFiles/{OrderId}") ?? new();

                    // 3. Загружаем историю чата
                    var history = await Http.GetFromJsonAsync<List<Message>>($"{BaseApiUrl}/api/messages/order/{OrderId}");
                    if (history != null)
                    {
                        chatMessages = history.Select(m => new ChatMessage
                            {
                                User = (m.SenderId == Guid.Empty) ? "Система" :
                                       (m.SenderId == Auth.User?.Id ? Auth.User.Username : (order.PartnerName ?? "Партнер")),
                                Text = m.Content,
                                Time = m.SentAt
                            }).ToList();

                        await ScrollToBottom();
                    }

                    // 4. Подключаемся к группе SignalR для получения сообщений в реальном времени
                    if (hubConnection?.State == HubConnectionState.Connected)
                    {
                        await hubConnection.SendAsync("JoinOrderGroup", OrderId.ToString());
                    }

                    // 5. ПРОВЕРКА ОТЗЫВА (Теперь работает благодаря миграции и обновленному контроллеру)
                    if (Auth.User.RoleId == 1 && order.Status == "Completed")
                    {
                        // Загружаем все отзывы данного инженера
                        var reviews = await Http.GetFromJsonAsync<List<Review>>($"{BaseApiUrl}/api/Reviews/engineer/{order.EngineerId}");

                        if (reviews != null)
                        {
                            // Ищем, есть ли среди них отзыв с ID текущего заказа
                            // Теперь r.OrderId существует в классе Review и в базе данных
                            isReviewSubmitted = reviews.Any(r => r.OrderId == OrderId);
                        }
                    }
                }
            }
            else
            {
                errorMessage = "Не удалось загрузить данные заказа.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Произошла ошибка при загрузке данных.";
            Console.WriteLine($"LoadAllData Error: {ex.Message}");
        }
    }

    private async Task SubmitReview()
    {
        if (reviewRating == 0 || order == null) return;

        isSavingReview = true;
        try
        {
            var review = new Review
                {
                    OrderId = order.Id,
                    ReviewerId = Auth.User!.Id,
                    RevieweeId = order.EngineerId, // Берем из модели
                    Rating = reviewRating,
                    Comment = reviewComment
                };

            var res = await Http.PostAsJsonAsync($"{BaseApiUrl}/api/Reviews", review);
            if (res.IsSuccessStatusCode)
            {
                isReviewSubmitted = true;
                await JS.InvokeVoidAsync("alert", "Спасибо! Ваш отзыв опубликован.");
            }
            else { await JS.InvokeVoidAsync("alert", "Ошибка при отправке отзыва."); }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isSavingReview = false; }
    }

    private async Task UploadOrderFile(InputFileChangeEventArgs e)
    {
        // 1. Объявляем переменную один раз в начале метода
        var file = e.File;

        // 2. Проверка расширения (только музыка)
        var allowedExtensions = new[] { ".mp3", ".wav", ".flac", ".aac", ".ogg" };
        var extension = Path.GetExtension(file.Name).ToLower();

        if (!allowedExtensions.Contains(extension))
        {
            await JS.InvokeVoidAsync("alert", "Ошибка: Разрешены только аудиофайлы (mp3, wav и т.д.)");
            return;
        }

        // 3. Проверка логики заказа (для инженеров)
        if (Auth.User?.RoleId == 2)
        {
            bool hasStems = orderFiles.Any(f => f.FileType == "Stems");
            if (!hasStems)
            {
                await JS.InvokeVoidAsync("alert", "Ошибка: Вы не можете загрузить результат, пока заказчик не прислал исходные дорожки!");
                return;
            }
        }

        isUploading = true;
        try
        {
            // ОШИБКА БЫЛА ТУТ: Мы удалили повторное объявление "var file = e.File;"

            using var content = new MultipartFormDataContent();
            // Используем переменную file, объявленную в начале метода
            var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024); // 100 MB
            var fileContent = new StreamContent(stream);
            content.Add(fileContent, "file", file.Name);

            var res = await Http.PostAsync($"{BaseApiUrl}/api/Files/upload", content);
            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<UploadResult>();
                var newFile = new OrderFile
                    {
                        OrderId = OrderId,
                        UploaderId = Auth.User!.Id,
                        FileName = file.Name,
                        FileUrl = result!.Url,
                        FileType = Auth.User.RoleId == 1 ? "Stems" : "Result"
                    };

                await Http.PostAsJsonAsync($"{BaseApiUrl}/api/OrderFiles", newFile);

                // Если загрузил инженер — переводим статус на проверку
                if (Auth.User.RoleId == 2) await UpdateStatus("UnderReview");

                await LoadAllData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Произошла ошибка при загрузке файла.");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task AcceptWork() => await UpdateStatus("Completed");

    private async Task UpdateStatus(string status)
    {
        try
        {
            var res = await Http.PatchAsync($"{BaseApiUrl}/api/orders/{OrderId}/status?newStatus={status}&currentUserId={Auth.User!.Id}", null);
            if (res.IsSuccessStatusCode) await LoadAllData();
        }
        catch (Exception ex) { Console.WriteLine($"UpdateStatus Error: {ex.Message}"); }
    }

    private async Task DeleteFile(int fileId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Вы уверены, что хотите удалить этот файл?");
        if (!confirmed) return;

        try
        {
            var res = await Http.DeleteAsync($"{BaseApiUrl}/api/OrderFiles/{fileId}");
            if (res.IsSuccessStatusCode)
            {
                // Обновляем список файлов локально
                orderFiles.RemoveAll(f => f.Id == fileId);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при удалении: {ex.Message}");
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || order == null) return;
        try
        {
            var msg = new Message { OrderId = OrderId, SenderId = Auth.User!.Id, Content = newMessage };
            var res = await Http.PostAsJsonAsync($"{BaseApiUrl}/api/messages", msg);

            if (res.IsSuccessStatusCode)
            {
                if (hubConnection?.State == HubConnectionState.Connected)
                    await hubConnection.SendAsync("SendMessage", OrderId.ToString(), Auth.User!.Username, newMessage);

                chatMessages.Add(new ChatMessage { User = Auth.User.Username, Text = newMessage });
                newMessage = "";
                await ScrollToBottom();
            }
        }
        catch (Exception ex) { Console.WriteLine($"SendMessage Error: {ex.Message}"); }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e) { if (e.Key == "Enter") await SendMessage(); }

    private string GetFullUrl(string? url) =>
        string.IsNullOrEmpty(url) ? "" : (url.StartsWith("http") ? url : $"{BaseApiUrl}/{url.TrimStart('/')}");

    private string TranslateStatus(string? s) => s switch
    {
        "WaitingForPayment" => "Ожидает оплаты",
        "InProgress" => "В работе",
        "UnderReview" => "На проверке",
        "Completed" => "Завершен",
        _ => "Создан"
    };

    private int GetStepValue(string? status) => status switch
    {
        "WaitingForPayment" => 1,
        "InProgress" => 2,
        "UnderReview" => 3,
        "Completed" => 4,
        _ => 1
    };

    private string GetStepClass(int step) => step <= GetStepValue(order?.Status) ? "active" : "";

    private async Task GoToPayment()
    {
        try
        {
            var response = await Http.PostAsync($"{BaseApiUrl}/api/orders/{OrderId}/pay", null);
            if (response.IsSuccessStatusCode)
            {
                var paymentUrl = (await response.Content.ReadAsStringAsync()).Trim('"');
                if (!string.IsNullOrEmpty(paymentUrl)) Nav.NavigateTo(paymentUrl);
            }
        }
        catch (Exception ex) { Console.WriteLine($"Payment Error: {ex.Message}"); }
    }

    public async ValueTask DisposeAsync() { if (hubConnection != null) await hubConnection.DisposeAsync(); }

    private async Task CheckStatus()
    {
        var res = await Http.GetFromJsonAsync<CheckResult>($"{BaseApiUrl}/api/orders/{OrderId}/check-status");
        if (res != null && res.Paid) { await LoadAllData(); await JS.InvokeVoidAsync("alert", "Оплата подтверждена! Инженер уведомлен."); }
        else { await JS.InvokeVoidAsync("alert", "ЮKassa пока не подтвердила платеж. Попробуйте через минуту."); }
    }

