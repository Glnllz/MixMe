    }

    .interaction-link {
        background: transparent;
        border: none;
        color: var(--text-dim);
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .interaction-link:hover {
            color: var(--pink);
        }

        .interaction-link.liked {
            color: var(--pink);
        }

        .interaction-link i {
            font-size: 1.3rem;
        }

    /* ПРАВАЯ ЧАСТЬ: ТОП */
    .widget-top {
        padding: 25px;
    }

    .widget-title {
        font-weight: 900;
        color: var(--pink);
        text-transform: uppercase;
        font-size: 1rem;
        margin-bottom: 25px;
        letter-spacing: 1px;
    }

    .top-item-row {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        align-items: center;
        cursor: pointer;
        transition: 0.3s;
    }

        .top-item-row:hover {
            transform: translateX(8px);
        }

    .mini-top-ava {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        overflow: hidden;
        background: #222;
    }

        .mini-top-ava img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .top-name {
        display: block;
        font-weight: 800;
        font-size: 1rem;
        color: white;
    }

    .top-rating {
        font-size: 0.85rem;
        color: #FFC107;
        font-weight: 800;
    }

    .btn-ghost-minimal {
        width: 100%;
        background: transparent;
        border: 1px solid var(--glass-border);
        color: var(--text-dim);
        padding: 10px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-ghost-minimal:hover {
            border-color: var(--pink);
            color: white;
        }

    /* СКРОЛЛБАР */
    .scroll-styled::-webkit-scrollbar {
        width: 6px;
    }

    .scroll-styled::-webkit-scrollbar-track {
        background: transparent;
    }

    .scroll-styled::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

        .scroll-styled::-webkit-scrollbar-thumb:hover {
            background: var(--pink);
        }

    .validation-msg {
        background: rgba(233, 30, 99, 0.1);
        border-left: 4px solid var(--pink);
        color: #ff8585;
        padding: 12px 20px;
        border-radius: 12px;
        margin: 15px 0;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    /* АНИМАЦИИ */
    .fade-in-up {
        animation: fadeInUp 0.5s ease-out forwards;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .moderation-alert {
        background: rgba(255, 193, 7, 0.1);
        border: 1px dashed #ffc107;
        color: #ffc107;
        padding: 12px;
        border-radius: 15px;
        margin-bottom: 15px;
        font-size: 0.85rem;
        font-weight: 600;
    }
</style>

@code {
    private List<PostViewModel>? posts;
    private List<TopEngineerViewModel>? topEngineers;
    private MixMeClient.Pages.OrderModal orderModal = default!;
    private string newPostContent = "";
    private string? tempImageUrl, tempAudioUrl;
    private int activeFilter = 0;
    private bool isSending = false;
    private string? validationError;
    private HubConnection? hubConnection;
    private string BaseApiUrl = "https://localhost:7237";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        // Настраиваем подключение к SignalR
        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{BaseApiUrl}/chathub")
            .WithAutomaticReconnect()
            .Build();

        // СЛУШАЕМ СОБЫТИЕ ОДОБРЕНИЯ ПОСТА
        hubConnection.On<int>("PostApproved", async (postId) =>
        {
            // Когда кто-то одобрил пост, просто заново загружаем данные
            await LoadData();
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task LoadData()
    {
        if (Auth.User == null) return;
        try
        {
            posts = await Http.GetFromJsonAsync<List<PostViewModel>>($"{BaseApiUrl}/api/posts?currentUserId={Auth.User.Id}");
            topEngineers = await Http.GetFromJsonAsync<List<TopEngineerViewModel>>($"{BaseApiUrl}/api/engineers/top");
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private void OpenOfferModal(Guid customerId)
    {
        // Переходим в профиль, но добавляем в адрес параметр action=offer
        Nav.NavigateTo($"/profile/{customerId}?action=offer");
    }

    private async Task HandleLike(PostViewModel post)
    {
        var res = await Http.PostAsync($"{BaseApiUrl}/api/posts/{post.Id}/like?userId={Auth.User!.Id}", null);
        if (res.IsSuccessStatusCode)
        {
            if (post.IsLiked) { post.LikeCount--; post.IsLiked = false; }
            else { post.LikeCount++; post.IsLiked = true; }
        }
    }

    private async Task DeletePost(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Вы уверены, что хотите удалить этот пост?");
        if (!confirmed) return;

        var res = await Http.DeleteAsync($"{BaseApiUrl}/api/posts/{id}?userId={Auth.User!.Id}");
        if (res.IsSuccessStatusCode) await LoadData();
    }

    private async Task UploadFile(InputFileChangeEventArgs e, bool isImage)
    {
        var content = new MultipartFormDataContent();
        var file = e.File;
        content.Add(new StreamContent(file.OpenReadStream(50 * 1024 * 1024)), "file", file.Name);

        var res = await Http.PostAsync($"{BaseApiUrl}/api/Files/upload", content);
        if (res.IsSuccessStatusCode)
        {
            var result = await res.Content.ReadFromJsonAsync<UploadResult>();
            if (isImage) tempImageUrl = result?.url; else tempAudioUrl = result?.url;
        }
    }

    private async Task CreatePost()
    {
        // Проверка на пустоту
        if (string.IsNullOrWhiteSpace(newPostContent))
        {
            validationError = "Вашим мыслям нужно немного слов! Пожалуйста, напишите что-нибудь, прежде чем делиться с миром.";

            // Убираем сообщение через 3 секунды автоматически
            _ = Task.Delay(3000).ContinueWith(_ => { validationError = null; InvokeAsync(StateHasChanged); });
            return;
        }

        if (Auth.User == null) return;

        validationError = null; // Сбрасываем ошибку, если всё ок
        isSending = true;

        var post = new Post
            {
                UserId = Auth.User.Id,
                Content = newPostContent,
                ImageUrl = tempImageUrl,
                AudioUrl = tempAudioUrl
            };

        var res = await Http.PostAsJsonAsync($"{BaseApiUrl}/api/posts", post);
        if (res.IsSuccessStatusCode)
        {
            newPostContent = ""; tempImageUrl = null; tempAudioUrl = null;
            await LoadData();
        }
        isSending = false;
    }

    private IEnumerable<PostViewModel> GetFilteredPosts()
    {
        if (posts == null) return new List<PostViewModel>();
        if (activeFilter == 0) return posts;
        return posts.Where(p => p.RoleId == activeFilter);
    }

    private string GetFullUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "images/default-avatar.png";
        return url.StartsWith("http") ? url : $"{BaseApiUrl}/{url.TrimStart('/')}";
    }

    public class PostViewModel
    {
        public int Id { get; set; }
        public Guid UserId { get; set; }
        public string Content { get; set; } = "";
        public string? ImageUrl { get; set; }
        public string? AudioUrl { get; set; }
        public int LikeCount { get; set; }
        public DateTime CreatedAt { get; set; }
        public string Username { get; set; } = "";
        public string? AvatarUrl { get; set; }
        public int RoleId { get; set; }
        public bool IsLiked { get; set; }
        public ModerationStatus Status { get; set; } = ModerationStatus.Pending;
    }

    public class TopEngineerViewModel
    {
        public Guid ProfileId { get; set; }
        public string Username { get; set; } = "";
        public string? AvatarUrl { get; set; }
        public double AvgRating { get; set; }
    }

    public class UploadResult { public string url { get; set; } = ""; }
}