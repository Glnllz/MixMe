@page "/search"
@using MixMeShared
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav

<BackgroundGlow />

<div class="search-page-layout scroll-styled">
    <div class="search-grid">
        <aside class="filter-sidebar fade-in">
            <div class="glass-box filter-card">
                <h3 class="filter-title"><i class="bi bi-search-heart me-2"></i> @(Auth.User?.RoleId == 2 ? "Поиск заказов" : "Поиск мастеров")</h3>
                <div class="filter-group">
                    <label>Ключевые слова</label>
                    <div class="search-input-wrapper"><i class="bi bi-search"></i><input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp" /></div>
                </div>
                @if (Auth.User?.RoleId == 1) {
                    <div class="filter-group"><label>Жанр</label><select @bind="selectedGenreId" class="custom-select-pro"><option value="">Все жанры</option>@foreach (var g in allGenres) { <option value="@g.Id">@g.Name</option> }</select></div>
                    <div class="filter-group"><label>Мин. рейтинг: @minRating ⭐</label><input type="range" min="0" max="5" step="0.5" @bind="minRating" class="pink-slider" /></div>
                }
                <div class="actions-stack"><button class="btn-search-main" @onclick="LoadData">Найти</button><button class="btn-reset-minimal" @onclick="ResetFilters">Сбросить</button></div>
            </div>
        </aside>

        <main class="results-area">
            <h1>@(Auth.User?.RoleId == 2 ? "Доступные проекты" : "Наши специалисты")</h1>
            @if (results == null) { <div class="search-loader-container"><div class="spinner-border text-pink"></div></div> }
            else if (results.Count == 0) { <div class="empty-results-box glass-box"><i class="bi bi-search-heart"></i><h3>Ничего не нашли</h3></div> }
            else {
                <div class="results-grid">
                    @foreach (var item in results) {
                        <div class="result-card glass-box fade-in-up">
                            <div class="card-top" @onclick='() => Nav.NavigateTo($"/profile/{item.ProfileId}")' style="cursor:pointer">
                                <div class="item-ava">
                                    @if (!string.IsNullOrEmpty(item.AvatarUrl)) { <img src="@GetFullUrl(item.AvatarUrl)" /> }
                                    else { <div class="placeholder-ava mini"><i class="bi bi-person-fill"></i></div> }
                                </div>
                                <div class="item-main-info">
                                    <h4>@item.Username</h4>
                                    @if (Auth.User?.RoleId == 1) { <div class="rating-stars"><span>⭐ @item.AvgRating.ToString("F1")</span></div> }
                                    else { <span class="role-badge-customer">Заказчик</span> }
                                </div>
                                @if (Auth.User?.RoleId == 1) { <div class="price-box">от @item.MinPrice.ToString("N0") ₽</div> }
                            </div>
                            <div class="item-description">@item.Bio</div>
                            <div class="card-footer-action">
                                @if (Auth.User?.RoleId == 1) {
                                    <button class="btn-action-outline" @onclick="() => OpenOrder(item.ProfileId, item.Username)"><i class="bi bi-cart-plus me-2"></i> Заказать</button>
                                } else {
                                    <button class="btn-action-outline" @onclick='() => Nav.NavigateTo($"/profile/{item.ProfileId}")'>Связаться</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<MixMeClient.Pages.OrderModal @ref="orderModal" EngineerId="@targetEngId" EngineerName="@targetEngName" />
<style>
    :root {
        --pink: #E91E63;
        --pink-soft: rgba(233, 30, 99, 0.1);
        --glass-bg: rgba(255, 255, 255, 0.03);
        --glass-border: rgba(255, 255, 255, 0.08);
        --text-muted: rgba(255, 255, 255, 0.4);
    }

    .search-page-layout {
        position: fixed;
        inset: 70px 0 0 0;
        overflow-y: auto;
        padding: 50px 5%;
    }

    .search-grid {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 40px;
        max-width: 1550px;
        margin: 0 auto;
    }

    .glass-box {
        background: var(--glass-bg);
        backdrop-filter: blur(25px);
        border: 1px solid var(--glass-border);
        border-radius: 30px;
        padding: 30px;
        transition: 0.3s;
    }

    /* ФИЛЬТРЫ СБОКУ */
    .filter-title {
        font-size: 1.1rem;
        font-weight: 900;
        color: var(--pink);
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 30px;
    }

    .filter-group {
        margin-bottom: 25px;
    }

        .filter-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--text-muted);
            margin-bottom: 10px;
            text-transform: uppercase;
        }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

        .search-input-wrapper i {
            position: absolute;
            left: 15px;
            color: var(--text-muted);
        }

        .search-input-wrapper input {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 14px 14px 14px 45px;
            color: white;
            outline: none;
            transition: 0.3s;
        }

            .search-input-wrapper input:focus {
                border-color: var(--pink);
                box-shadow: 0 0 15px var(--pink-soft);
            }

    .custom-select-pro {
        width: 100%;
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--glass-border);
        border-radius: 14px;
        padding: 14px;
        color: white;
        outline: none;
        cursor: pointer;
    }

        .custom-select-pro option {
            background: #1a1a1a;
            color: white;
        }

    .pink-slider {
        width: 100%;
        accent-color: var(--pink);
        cursor: pointer;
    }

    .actions-stack {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-search-main {
        background: var(--pink);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 8px 20px rgba(233, 30, 99, 0.3);
    }

        .btn-search-main:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }

    .btn-reset-minimal {
        background: transparent;
        border: 1px solid var(--glass-border);
        color: var(--text-muted);
        padding: 12px;
        border-radius: 14px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-reset-minimal:hover {
            color: white;
            border-color: white;
        }

    .info-badge h6 {
        font-weight: 800;
        margin: 0;
    }

    .info-badge p {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin: 0;
    }

    .icon-circle {
        width: 40px;
        height: 40px;
        background: var(--pink-soft);
        color: var(--pink);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    /* ОБЛАСТЬ РЕЗУЛЬТАТОВ */
    .results-header {
        margin-bottom: 40px;
    }

        .results-header h1 {
            font-size: 3.2rem;
            font-weight: 900;
            letter-spacing: -3px;
            margin: 0;
        }

        .results-header p {
            font-size: 1.2rem;
            color: var(--text-muted);
            font-weight: 500;
        }

    .highlight-count {
        color: var(--pink);
        font-weight: 800;
    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 25px;
    }

    .result-card {
        cursor: pointer;
        border: 1px solid var(--glass-border);
        position: relative;
        overflow: hidden;
    }

        .result-card:hover {
            border-color: var(--pink);
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

    .card-top {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .item-ava {
        width: 75px;
        height: 75px;
        border-radius: 22px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.1);
        flex-shrink: 0;
        background: #111;
    }

        .item-ava img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .placeholder-ava.mini {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: #333;
        background: #222;
    }

    .item-main-info h4 {
        font-size: 1.4rem;
        font-weight: 800;
        margin: 0;
        color: white;
    }

    .rating-stars {
        color: #555;
        font-size: 0.9rem;
        margin-top: 5px;
    }

        .rating-stars .active {
            color: #FFC107;
        }

    .rating-val {
        color: white;
        font-weight: 800;
        margin-left: 8px;
    }

    .role-badge-customer {
        background: rgba(0, 188, 212, 0.1);
        color: #00bcd4;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 900;
        text-transform: uppercase;
        display: inline-block;
        margin-top: 5px;
    }

    .price-box {
        margin-left: auto;
        background: var(--pink-soft);
        color: var(--pink);
        padding: 10px 18px;
        border-radius: 14px;
        font-weight: 900;
        font-size: 1rem;
    }

    .item-description {
        font-size: 1.05rem;
        color: rgba(255,255,255,0.7);
        line-height: 1.6;
        margin-bottom: 25px;
        height: 3.2em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 25px;
    }

    .tag-pink {
        background: rgba(233, 30, 99, 0.05);
        border: 1px solid rgba(233, 30, 99, 0.1);
        padding: 6px 14px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--pink);
        text-transform: uppercase;
    }

    .card-footer-action {
        border-top: 1px solid var(--glass-border);
        padding-top: 20px;
    }

    .btn-action-outline {
        width: 100%;
        background: transparent;
        border: 1px solid var(--glass-border);
        color: white;
        padding: 12px;
        border-radius: 14px;
        font-weight: 800;
        transition: 0.3s;
    }

    .result-card:hover .btn-action-outline {
        background: white;
        color: black;
        border-color: white;
    }

    /* LOADING & EMPTY */
    .search-loader-container {
        text-align: center;
        padding: 100px;
        color: var(--text-muted);
    }

    .empty-results-box {
        text-align: center;
        padding: 80px 40px;
        color: var(--text-muted);
    }

        .empty-results-box i {
            font-size: 5rem;
            color: var(--glass-border);
            display: block;
            margin-bottom: 20px;
        }

    .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* CUSTOM SCROLL */
    .scroll-styled::-webkit-scrollbar {
        width: 6px;
    }

    .scroll-styled::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

        .scroll-styled::-webkit-scrollbar-thumb:hover {
            background: var(--pink);
        }
</style>

@code {
    private MixMeClient.Pages.OrderModal orderModal = default!;
    private Guid targetEngId;
    private string targetEngName = "";

    private List<SearchItemViewModel>? results;
    private List<Genre> allGenres = new();
    private string searchQuery = "", BaseApiUrl = "https://localhost:7237";
    private int? selectedGenreId;
    private double minRating = 0;

    protected override async Task OnInitializedAsync()
    {
        allGenres = await Http.GetFromJsonAsync<List<Genre>>($"{BaseApiUrl}/api/dictionary/genres") ?? new();
        await LoadData();
    }

    private void OpenOrder(Guid id, string name) { targetEngId = id; targetEngName = name; orderModal.Show(); }
    private async Task HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await LoadData(); }

    private async Task LoadData()
    {
        results = null;
        try
        {
            if (Auth.User?.RoleId == 2)
            {
                var data = await Http.GetFromJsonAsync<List<PostSearchModel>>($"{BaseApiUrl}/api/posts/search?query={searchQuery}");
                results = data?.Select(d => new SearchItemViewModel { ProfileId = d.UserId, Username = d.Username, AvatarUrl = d.AvatarUrl, Bio = d.Content }).ToList();
            }
            else
            {
                var url = $"{BaseApiUrl}/api/engineers/search?query={searchQuery}&minRating={minRating}" + (selectedGenreId.HasValue ? $"&genreId={selectedGenreId}" : "");
                var data = await Http.GetFromJsonAsync<List<EngineerSearchViewModel>>(url);
                results = data?.Select(d => new SearchItemViewModel { ProfileId = d.ProfileId, Username = d.Username, AvatarUrl = d.AvatarUrl, Bio = d.Bio, AvgRating = d.AvgRating, MinPrice = d.MinPrice }).ToList();
            }
        }
        catch { results = new List<SearchItemViewModel>(); }
    }

    private async Task ResetFilters() { searchQuery = ""; selectedGenreId = null; minRating = 0; await LoadData(); }
    private string GetFullUrl(string? url) => string.IsNullOrEmpty(url) ? "images/default-avatar.png" : (url.StartsWith("http") ? url : $"{BaseApiUrl}/{url.TrimStart('/')}");

    public class SearchItemViewModel { public Guid ProfileId { get; set; } public string Username { get; set; } = ""; public string? AvatarUrl { get; set; } public string Bio { get; set; } = ""; public double AvgRating { get; set; } public decimal MinPrice { get; set; } }
    public class PostSearchModel { public Guid UserId { get; set; } public string Username { get; set; } = ""; public string? AvatarUrl { get; set; } public string Content { get; set; } = ""; }
    public class EngineerSearchViewModel { public Guid ProfileId { get; set; } public string Username { get; set; } = ""; public string? AvatarUrl { get; set; } public string Bio { get; set; } = ""; public double AvgRating { get; set; } public decimal MinPrice { get; set; } }
}