@page "/admin"
@using MixMeShared
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="admin-layout fade-in">
    @* --- SIDEBAR (Боковая панель) --- *@
    <aside class="admin-sidebar">
        <div class="admin-logo">
            <i class="bi bi-shield-lock-fill"></i>
            <span>Модератор МиксМи</span>
        </div>
        <nav class="admin-nav">
            <button class="@(activeTab == "stats" ? "active" : "")" @onclick='() => ChangeTab("stats")'>
                <i class="bi bi-grid-1x2-fill"></i> Дашборд
            </button>
            <button class="@(activeTab == "users" ? "active" : "")" @onclick='() => activeTab = "users"'>
                <i class="bi bi-people-fill"></i> Пользователи
            </button>
            <button class="@(activeTab == "posts" ? "active" : "")" @onclick='() => activeTab = "posts"'>
                <i class="bi bi-images"></i> Посты
                @if (stats?.PendingPostsCount > 0)
                {
                    <span class="badge">@stats.PendingPostsCount</span>
                }
            </button>
            <button class="@(activeTab == "reviews" ? "active" : "")" @onclick='() => activeTab = "reviews"'>
                <i class="bi bi-star-half"></i> Отзывы
                @if (stats?.PendingReviewsCount > 0)
                {
                    <span class="badge">@stats.PendingReviewsCount</span>
                }
            </button>
            <button class="@(activeTab == "complaints" ? "active" : "")" @onclick='() => activeTab = "complaints"'>
                <i class="bi bi-exclamation-octagon-fill"></i> Жалобы
                @if (stats?.ActiveDisputesCount > 0)
                {
                    <span class="badge red">@stats.ActiveDisputesCount</span>
                }
            </button>
        </nav>
        <div class="sidebar-footer">
            <div class="connection-status @(hubConnection?.State == HubConnectionState.Connected ? "online" : "offline")">
                @(hubConnection?.State == HubConnectionState.Connected ? "Live Update On" : "Live Update Off")
            </div>
            <button class="btn-back-site" @onclick="HandleLogout" style="border-color: #ff5252; color: #ff5252; margin-top: 20px;">
                <i class="bi bi-box-arrow-right me-2"></i> Выйти из системы
            </button>
        </div>
    </aside>

    @* --- MAIN CONTENT (Основная область) --- *@
    <main class="admin-main-content">
        @if (isLoading)
        {
            <div class="admin-loader"><div class="spinner-premium"></div></div>
        }
        else
        {
            @* --- СЕКЦИЯ: ДАШБОРД --- *@
            @if (activeTab == "stats")
            {
                <div class="admin-section">
                    <h2 class="section-title">Состояние платформы</h2>
                    <div class="stats-grid-admin">
                        <div class="stat-card-admin pink">
                            <i class="bi bi-cash-coin"></i>
                            <div class="s-data">
                                <span class="val">@stats?.TotalTurnover.ToString("N0") ₽</span>
                                <span class="lbl">Общий оборот</span>
                            </div>
                        </div>
                        <div class="stat-card-admin">
                            <i class="bi bi-people"></i>
                            <div class="s-data">
                                <span class="val">@stats?.TotalUsers</span>
                                <span class="lbl">Пользователей</span>
                            </div>
                        </div>
                        <div class="stat-card-admin blue">
                            <i class="bi bi-person-badge"></i>
                            <div class="s-data">
                                <span class="val">@stats?.TotalEngineers</span>
                                <span class="lbl">Инженеров</span>
                            </div>
                        </div>
                    </div>
                    <div class="admin-section mt-5">
                        <h3 class="section-title">Динамика оборота</h3>
                        <div class="chart-container-admin glass-box">
                            <canvas id="turnoverChart"></canvas>
                        </div>
                    </div>
                </div>
            }

            @* --- СЕКЦИЯ: ПОЛЬЗОВАТЕЛИ --- *@
            @if (activeTab == "users")
            {
                <div class="admin-section">
                    <div class="section-header-admin">
                        <h2 class="section-title">Управление доступом</h2>
                        <div class="admin-search-box">
                            <i class="bi bi-search"></i>
                            <input type="text" @bind="userSearch" @bind:event="oninput" @onkeyup="LoadUsers" placeholder="Поиск по нику или email..." />
                        </div>
                    </div>

                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Имя пользователя</th>
                                    <th>Email</th>
                                    <th>Статус</th>
                                    <th>Действие</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in users)
                                {
                                    <tr>
                                        <td><b>@u.Username</b></td>
                                        <td>@u.Email</td>
                                        <td>
                                            <span class="u-status @(u.IsBanned ? "banned" : "active")">
                                                @(u.IsBanned ? "Забанен" : "Активен")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn-ban-toggle @(u.IsBanned ? "unban" : "ban")" @onclick="() => ToggleBan(u)">
                                                @(u.IsBanned ? "Разбанить" : "Забанить")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* --- СЕКЦИЯ: ПОСТЫ --- *@
            @if (activeTab == "posts")
            {
                <div class="admin-section">
                    <h2 class="section-title">Модерация контента</h2>
                    <div class="mod-grid-admin">
                        @foreach (var p in pendingPosts)
                        {
                            <div class="mod-card-admin glass-box fade-in-up">
                                <div class="m-author">
                                    <i class="bi bi-person-circle me-2"></i> @p.AuthorName
                                </div>

                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <div class="m-preview-img">
                                        <img src="@GetFullUrl(p.ImageUrl)" alt="post image" />
                                    </div>
                                }

                                <div class="m-content">@p.Content</div>

                                @if (!string.IsNullOrEmpty(p.AudioUrl))
                                {
                                    <div class="m-preview-audio">
                                        <i class="bi bi-music-note-beamed me-2"></i> Аудио вложение
                                    </div>
                                }

                                <div class="m-btns">
                                    <button class="btn-admin-act green" @onclick="() => UpdatePost(p.Id, ModerationStatus.Approved)">
                                        <i class="bi bi-check-lg"></i> Одобрить
                                    </button>
                                    <button class="btn-admin-act red" @onclick="() => UpdatePost(p.Id, ModerationStatus.Rejected)">
                                        <i class="bi bi-trash3"></i> Удалить
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* --- СЕКЦИЯ: ОТЗЫВЫ (ВОССТАНОВЛЕНО) --- *@
            @if (activeTab == "reviews")
            {
                <div class="admin-section">
                    <h2 class="section-title">Модерация отзывов</h2>
                    <div class="grid-list-admin">
                        @foreach (var rev in pendingReviews)
                        {
                            <div class="mod-card-admin">
                                <div class="m-info">
                                    <span class="m-author">От: @rev.ReviewerName | Для: @rev.EngineerName</span>
                                    <div class="m-stars">⭐ @rev.Rating/5</div>
                                    <p class="m-content">@rev.Comment</p>
                                </div>
                                <div class="m-btns">
                                    <button class="btn-admin-act green" @onclick="() => ApproveReview(rev.Id)">Одобрить</button>
                                    <button class="btn-admin-act red" @onclick="() => RejectReview(rev.Id)">Удалить</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* --- СЕКЦИЯ: ЖАЛОБЫ И АРБИТРАЖ --- *@
            @if (activeTab == "complaints")
            {
                <div class="admin-section">
                    <h2 class="section-title">Арбитраж и Жалобы</h2>
                    <div class="complaints-list-admin">
                        @foreach (var c in complaints)
                        {
                            <div class="complaint-item-admin">
                                <div class="c-head">
                                    <span class="c-reason">@c.Reason</span>
                                    <span class="c-date">@c.CreatedAt.ToString("g")</span>
                                </div>
                                <div class="c-users"><b>@c.SenderName</b> жалуется на <b>@c.TargetName</b></div>
                                <div class="c-comment">"@c.Comment"</div>
                                <div class="c-actions">
                                    @if (c.OrderId != null && c.OrderId != Guid.Empty)
                                    {
                                        <button class="btn-admin-act green" @onclick='() => ResolveOrder(c.OrderId.Value, "Pay", c.Id)'>Выплатить инженеру (@c.OrderAmount ₽)</button>
                                        <button class="btn-admin-act red" @onclick='() => ResolveOrder(c.OrderId.Value, "Refund", c.Id)'>Вернуть деньги</button>
                                        <button class="btn-admin-act blue" @onclick='() => Nav.NavigateTo($"/order/{c.OrderId}")'>Чат заказа</button>
                                    }
                                    else
                                    {
                                        <button class="btn-admin-act" @onclick="() => ResolveComplaint(c.Id)">Пометить решенным</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </main>
</div>

<style>
    /* ПЕРЕМЕННЫЕ И БАЗОВЫЙ МАКЕТ */
    :root {
        --pink: #E91E63;
    }

    .admin-layout {
        position: fixed;
        inset: 0;
        background: #0B0B0B;
        z-index: 9999;
        display: grid;
        grid-template-columns: 280px 1fr;
    }

    /* САЙДБАР (SIDEBAR) */
    .admin-sidebar {
        background: #111;
        border-right: 1px solid rgba(255,255,255,0.05);
        display: flex;
        flex-direction: column;
        padding: 40px 0;
    }

    .admin-logo {
        padding: 0 30px 40px;
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--pink);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .admin-nav {
        flex-grow: 1;
    }

        .admin-nav button {
            width: 100%;
            background: transparent;
            border: none;
            padding: 15px 30px;
            color: rgba(255,255,255,0.5);
            display: flex;
            align-items: center;
            gap: 15px;
            font-weight: 700;
            transition: 0.3s;
            border-right: 3px solid transparent;
            text-align: left;
            cursor: pointer;
        }

            .admin-nav button i {
                font-size: 1.2rem;
                transition: 0.3s;
            }

            .admin-nav button:hover,
            .admin-nav button.active {
                background: rgba(233, 30, 99, 0.05);
                color: white;
                border-right-color: var(--pink);
            }

                .admin-nav button:hover i {
                    transform: scale(1.2);
                }

    /* ВСПОМОГАТЕЛЬНЫЕ ЭЛЕМЕНТЫ САЙДБАРА */
    .badge {
        background: #444;
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 8px;
        margin-left: auto;
    }

        .badge.red {
            background: #ff5252;
        }

    .sidebar-footer {
        padding: 30px;
    }

    .connection-status {
        font-size: 0.7rem;
        margin-bottom: 10px;
        padding-left: 5px;
    }

        .connection-status.online {
            color: #4CAF50;
        }

        .connection-status.offline {
            color: #ff5252;
        }

    .btn-back-site {
        width: 100%;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        padding: 12px;
        border-radius: 12px;
        cursor: pointer;
        transition: 0.3s;
    }

    /* ОСНОВНОЙ КОНТЕНТ */
    .admin-main-content {
        padding: 50px;
        overflow-y: auto;
        color: white;
    }

    .section-title {
        font-size: 2rem;
        font-weight: 900;
        margin-bottom: 30px;
    }

    /* МОДЕРАЦИЯ (СЕТКА И КАРТОЧКИ) */
    .mod-grid-admin {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    .mod-card-admin {
        background: #1a1a1a;
        background: rgba(255, 255, 255, 0.02);
        padding: 25px;
        border-radius: 25px;
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        border: 1px solid rgba(255,255,255,0.05);
        transition: 0.3s;
    }

    .m-author {
        color: var(--pink);
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .m-stars {
        color: #FFC107;
        margin: 5px 0;
        font-weight: bold;
    }

    .m-content {
        font-size: 0.95rem;
        color: #ccc;
        line-height: 1.4;
    }

    .m-preview-img {
        width: 100%;
        height: 180px;
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .m-preview-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .m-preview-audio {
        background: rgba(233, 30, 99, 0.1);
        color: var(--pink);
        padding: 10px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    /* КНОПКИ ДЕЙСТВИЙ */
    .btn-admin-act {
        border: none;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 800;
        cursor: pointer;
        margin-left: 10px;
        transition: 0.2s;
    }

        .btn-admin-act.green {
            background: #4CAF50;
            color: white;
        }

        .btn-admin-act.red {
            background: #ff5252;
            color: white;
        }

        .btn-admin-act.blue {
            background: #00bcd4;
            color: white;
        }

        .btn-admin-act:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }

    /* КНОПКИ БАНА */
    .btn-ban-toggle {
        border: 1px solid transparent;
        padding: 8px 16px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.8rem;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-ban-toggle.ban {
            background: rgba(255, 82, 82, 0.1);
            color: #ff5252;
            border-color: rgba(255, 82, 82, 0.2);
        }

            .btn-ban-toggle.ban:hover {
                background: #ff5252;
                color: white;
            }

        .btn-ban-toggle.unban {
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
            border-color: rgba(76, 175, 80, 0.2);
        }

            .btn-ban-toggle.unban:hover {
                background: #4CAF50;
                color: white;
            }

    /* ТАБЛИЦА */
    .admin-table-wrapper {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 25px;
        padding: 10px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table th {
            background: #222;
            padding: 15px;
            text-align: left;
            color: #888;
            font-size: 0.8rem;
        }

        .admin-table td {
            padding: 20px 15px;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .admin-table b {
            color: #fff;
            font-size: 1.05rem;
        }

        .admin-table tr:hover td {
            background: rgba(255, 255, 255, 0.01);
        }

    .u-status {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 900;
    }

        .u-status.active {
            background: rgba(76, 175, 80, 0.1);
            color: #4CAF50;
        }

        .u-status.banned {
            background: rgba(255, 82, 82, 0.1);
            color: #ff5252;
        }

    /* СТАТИСТИКА */
    .stats-grid-admin {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .stat-card-admin {
        background: #1a1a1a;
        padding: 30px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .stat-card-admin i {
            font-size: 2.5rem;
            color: #666;
        }

        .stat-card-admin.pink i {
            color: var(--pink);
        }

        .stat-card-admin.blue i {
            color: #00bcd4;
        }

        .stat-card-admin .val {
            display: block;
            font-size: 1.8rem;
            font-weight: 900;
        }

        .stat-card-admin .lbl {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
        }

    /* ЖАЛОБЫ (COMPLAINTS) */
    .complaint-item-admin {
        background: #1a1a1a;
        padding: 25px;
        border-radius: 20px;
        margin-bottom: 20px;
        border-left: 5px solid var(--pink);
    }

    .c-head {
        display: flex;
        justify-content: space-between;
    }

    .c-reason {
        color: var(--pink);
        font-weight: 900;
        text-transform: uppercase;
        font-size: 0.8rem;
    }

    .c-comment {
        background: rgba(0,0,0,0.2);
        padding: 15px;
        border-radius: 12px;
        margin: 15px 0;
        font-style: italic;
        color: #ccc;
    }

    .chart-container-admin {
        height: 350px;
        width: 100%;
        padding: 30px;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
    /* Контейнер поиска */
    .admin-search-box {
        position: relative;
        width: 350px; /* Фиксированная ширина для аккуратности */
        margin-bottom: 5px;
    }

        /* Иконка лупы внутри поиска */
        .admin-search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.3); /* Приглушенный цвет */
            pointer-events: none; /* Чтобы иконка не мешала клику по инпуту */
            transition: 0.3s;
        }

        /* Само поле ввода */
        .admin-search-box input {
            width: 100%;
            background: rgba(255, 255, 255, 0.03); /* Почти прозрачный фон */
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 15px 12px 45px; /* Отступ слева под иконку */
            color: white;
            font-weight: 600;
            outline: none;
            transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            /* Эффект при наведении */
            .admin-search-box input:hover {
                background: rgba(255, 255, 255, 0.05);
                border-color: rgba(255, 255, 255, 0.2);
            }

            /* Эффект при фокусе (клике) */
            .admin-search-box input:focus {
                background: rgba(255, 255, 255, 0.07);
                border-color: var(--pink); /* Розовый акцент как в логотипе */
                box-shadow: 0 0 15px rgba(233, 30, 99, 0.15); /* Мягкое розовое свечение */
            }

                /* Изменение цвета иконки при фокусе на инпуте */
                .admin-search-box input:focus + i,
                .admin-search-box:focus-within i {
                    color: var(--pink);
                }

            /* Стилизация плейсхолдера (подсказки) */
            .admin-search-box input::placeholder {
                color: rgba(255, 255, 255, 0.2);
                font-weight: 400;
            }
</style>

@code {
    private string activeTab = "stats";
    private string userSearch = "";
    private bool isLoading = true;
    private string BaseApiUrl = "https://localhost:7237";

    private AdminDashboardStatsDto? stats;
    private List<AdminUserListItemDto> users = new();
    private List<AdminPostDto> pendingPosts = new();
    private List<AdminReviewDto> pendingReviews = new();
    private List<AdminComplaintDto> complaints = new();

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.User?.RoleId != 3) { Nav.NavigateTo("/feed"); return; }

        await RefreshAll();

        // SignalR для живого обновления
        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{BaseApiUrl}/chathub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("UpdateAdminPanel", async () =>
        {
            await RefreshAll();
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task RefreshAll()
    {
        isLoading = true;
        try
        {
            // Загружаем все данные
            stats = await Http.GetFromJsonAsync<AdminDashboardStatsDto>($"{BaseApiUrl}/api/Admin/stats");
            await LoadUsers();
            pendingPosts = await Http.GetFromJsonAsync<List<AdminPostDto>>($"{BaseApiUrl}/api/Admin/posts/pending") ?? new();
            pendingReviews = await Http.GetFromJsonAsync<List<AdminReviewDto>>($"{BaseApiUrl}/api/Admin/reviews/pending") ?? new();
            complaints = await Http.GetFromJsonAsync<List<AdminComplaintDto>>($"{BaseApiUrl}/api/Admin/complaints/pending") ?? new();

            // --- ИСПРАВЛЕНИЕ ТУТ ---
            isLoading = false; // Сначала выключаем лоадер
            StateHasChanged(); // Принудительно обновляем UI, чтобы появился canvas в DOM

            await Task.Delay(150); // Даем браузеру время отрисовать элементы
            await RenderTurnoverChart(); // Теперь рисуем график
        }
        catch (Exception ex)
        {
            isLoading = false;
            Console.WriteLine($"Ошибка загрузки статистики: {ex.Message}");
        }
    }
    private async Task RenderTurnoverChart()
    {
        if (stats?.TurnoverHistory == null || !stats.TurnoverHistory.Any()) return;

        var labels = stats.TurnoverHistory.Select(x => x.Month).ToArray();
        var data = stats.TurnoverHistory.Select(x => x.Amount).ToArray();

        // Вызываем JS функцию для отрисовки
        await JS.InvokeVoidAsync("renderAdminChart", labels, data);
    }
    private async Task ChangeTab(string tabName)
    {
        activeTab = tabName;
        if (tabName == "stats")
        {
            StateHasChanged();
            await Task.Delay(100);
            await RenderTurnoverChart();
        }
    }

    private async Task LoadUsers() =>
        users = await Http.GetFromJsonAsync<List<AdminUserListItemDto>>($"{BaseApiUrl}/api/Admin/users?search={userSearch}") ?? new();

    private async Task ToggleBan(AdminUserListItemDto u)
    {
        if (u.Id == Auth.User?.Id)
        {
            await JS.InvokeVoidAsync("alert", "Ошибка: Вы пытаетесь заблокировать собственную учетную запись администратора!");
            return;
        }

        var res = await Http.PatchAsync($"{BaseApiUrl}/api/Admin/users/{u.Id}/ban", null);
        if (res.IsSuccessStatusCode)
        {
            u.IsBanned = !u.IsBanned;
        }
        else
        {
            var error = await res.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", error);
        }
    }
    private string GetFullUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "images/default-avatar.png";
        return url.StartsWith("http") ? url : $"{BaseApiUrl}/{url.TrimStart('/')}";
    }
    private async Task HandleLogout()
    {
        await Auth.Logout();
        Nav.NavigateTo("/login");
    }

    private async Task UpdatePost(int id, ModerationStatus status)
    {
        await Http.PatchAsync($"{BaseApiUrl}/api/Admin/posts/{id}/status?status={status}", null);
        await RefreshAll();
    }

    private async Task ApproveReview(int id)
