@page "/admin"
@using MixMeShared
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<BackgroundGlow />

<div class="admin-container fade-in">
    <header class="admin-header">
        <h1>Панель модератора</h1>
        <div class="admin-tabs">
            <button class="tab @(activeTab == "posts" ? "active" : "")" @onclick='() => activeTab = "posts"'>Посты</button>
            <button class="tab @(activeTab == "reviews" ? "active" : "")" @onclick='() => activeTab = "reviews"'>Отзывы</button>
            <button class="tab @(activeTab == "orders" ? "active" : "")" @onclick='() => activeTab = "orders"'>Арбитраж и Жалобы</button>
        </div>
    </header>

    <div class="admin-content">
        @if (activeTab == "posts")
        {
            <div class="grid-list">
                @foreach (var post in pendingPosts)
                {
                    <div class="admin-card glass-box">
                        <div class="card-info">
                            <span class="author">Автор: @post.AuthorName</span>
                            <p>@post.Content</p>
                        </div>
                        <div class="card-actions">
                            <button class="btn-approve" @onclick="() => ApprovePost(post.Id)">Одобрить</button>
                            <button class="btn-reject" @onclick="() => RejectPost(post.Id)">Удалить</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (activeTab == "reviews")
        {
            <div class="grid-list">
                @foreach (var rev in pendingReviews)
                {
                    <div class="admin-card glass-box">
                        <div class="card-info">
                            <span class="author">От: @rev.ReviewerName | Для: @rev.EngineerName</span>
                            <div class="stars">⭐ @rev.Rating/5</div>
                            <p>@rev.Comment</p>
                        </div>
                        <div class="card-actions">
                            <button class="btn-approve" @onclick="() => ApproveReview(rev.Id)">Разрешить</button>
                            <button class="btn-reject" @onclick="() => RejectReview(rev.Id)">Удалить</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (activeTab == "orders")
        {
            <div class="grid-list">
                @foreach (var c in pendingComplaints)
                {
                    <div class="admin-card-pro glass-box">
                        <div class="card-badge">
                            <span class="badge-pink">@c.Reason</span>
                            <span class="date">@c.CreatedAt.ToString("dd.MM HH:mm")</span>
                        </div>

                        <div class="card-body-admin">
                            <div class="user-info-row">
                                <span class="label">Инициатор:</span> <b>@c.SenderName</b>
                                <i class="bi bi-arrow-right mx-2"></i>
                                <span class="label">На кого:</span> <b>@c.TargetName</b>
                            </div>

                            <div class="comment-box">
                                <i class="bi bi-chat-quote me-2"></i> "@c.Comment"
                            </div>

                            @if (c.OrderId.HasValue && c.OrderId != Guid.Empty)
                            {
                                <div class="order-finance-info">
                                    <i class="bi bi-cash-stack me-2"></i> Сумма сделки: <b>@c.OrderAmount ₽</b>
                                </div>
                            }
                        </div>

                        <div class="card-actions-pro">
                            @if (c.OrderId.HasValue && c.OrderId != Guid.Empty)
                            {
                                @* Кнопки для финансовых споров *@
                                <button class="btn-admin pay" @onclick='() => ResolveOrder(c.OrderId.Value, "Pay", c.Id)'>
                                    <i class="bi bi-check2-circle"></i> Выплатить инженеру
                                </button>
                                <button class="btn-admin refund" @onclick='() => ResolveOrder(c.OrderId.Value, "Refund", c.Id)'>
                                    <i class="bi bi-arrow-counterclockwise"></i> Вернуть заказчику
                                </button>
                                <button class="btn-admin view" @onclick='() => Nav.NavigateTo($"/order/{c.OrderId}")'>
                                    <i class="bi bi-eye"></i> Чат
                                </button>
                            }
                            else
                            {
                                @* Кнопка для обычной жалобы *@
                                <button class="btn-admin approve-simple" @onclick="() => ResolveComplaint(c.Id)">
                                    <i class="bi bi-check-all"></i> Рассмотрено
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    :root {
        --pink: #E91E63;
        --pink-hover: #ff2e75;
    }

    .admin-card-pro {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 25px;
        margin-bottom: 20px;
        transition: 0.3s;
    }

        .admin-card-pro:hover {
            border-color: var(--pink);
            box-shadow: 0 10px 30px rgba(233, 30, 99, 0.1);
        }

    .card-badge {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .badge-pink {
        background: rgba(233, 30, 99, 0.2);
        color: var(--pink);
        padding: 5px 15px;
        border-radius: 10px;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .comment-box {
        background: rgba(0,0,0,0.2);
        padding: 15px;
        border-radius: 14px;
        margin: 15px 0;
        color: #eee;
        font-style: italic;
        border-left: 3px solid var(--pink);
    }

    .btn-admin {
        border: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-admin.pay {
            background: var(--pink);
            color: white;
        }

        .btn-admin.refund {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .btn-admin.view {
            background: #00bcd4;
            color: white;
        }

        .btn-admin.approve-simple {
            background: #4CAF50;
            color: white;
        }

        .btn-admin:hover {
            transform: translateY(-2px);
            filter: brightness(1.2);
        }

    .card-actions-pro {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
    }
    .admin-container {
        padding: 100px 50px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .admin-tabs {
        display: flex;
        gap: 15px;
        background: rgba(255,255,255,0.05);
        padding: 8px;
        border-radius: 15px;
    }

    .tab {
        background: transparent;
        border: none;
        color: #888;
        padding: 10px 25px;
        border-radius: 10px;
        cursor: pointer;
        transition: 0.3s;
        font-weight: 700;
    }

        .tab.active {
            background: #E91E63;
            color: white;
        }

    .admin-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px;
        margin-bottom: 20px;
        border-radius: 25px;
    }

    .card-info .author {
        color: #E91E63;
        font-weight: 800;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .card-info p {
        margin-top: 10px;
        font-size: 1.1rem;
        color: #eee;
    }

    .card-actions {
        display: flex;
        gap: 10px;
    }

    .btn-approve {
        background: #4CAF50;
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-reject {
        background: #F44336;
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
    }

    .btn-view {
        background: #2196F3;
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
    }
</style>

@code {
    private string activeTab = "posts";
    private List<AdminPostDto> pendingPosts = new();
    private List<AdminReviewDto> pendingReviews = new();
    private List<AdminOrderDto> disputedOrders = new();
    private List<AdminComplaintDto> pendingComplaints = new();
    private string BaseApiUrl = "https://localhost:7237";

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.User?.RoleId != 3) { Nav.NavigateTo("/"); return; }

        await LoadData();

        // Настраиваем SignalR для мгновенного обновления
        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{BaseApiUrl}/chathub")
            .WithAutomaticReconnect()
            .Build();

        // Слушаем сигнал "Обнови админку"
        hubConnection.On("UpdateAdminPanel", async () =>
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadData()
    {
        try
        {
            pendingPosts = await Http.GetFromJsonAsync<List<AdminPostDto>>($"{BaseApiUrl}/api/Admin/posts/pending") ?? new();
            pendingReviews = await Http.GetFromJsonAsync<List<AdminReviewDto>>($"{BaseApiUrl}/api/Admin/reviews/pending") ?? new();
            disputedOrders = await Http.GetFromJsonAsync<List<AdminOrderDto>>($"{BaseApiUrl}/api/Admin/orders/disputed") ?? new();
            pendingComplaints = await Http.GetFromJsonAsync<List<AdminComplaintDto>>($"{BaseApiUrl}/api/Admin/complaints/pending") ?? new();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }
    private async Task ResolveComplaint(int id)
    {
        var res = await Http.PatchAsync($"{BaseApiUrl}/api/Admin/complaints/{id}/resolve", null);
        if (res.IsSuccessStatusCode)
        {
            await LoadData();
        }
    }

    // Методы Approve/Reject (оставляем как были)
    private async Task ApprovePost(int id)
    {
        await Http.PatchAsync($"{BaseApiUrl}/api/Admin/posts/{id}/status?status=Approved", null);
        await LoadData();
    }

    private async Task RejectPost(int id)
    {
        await Http.PatchAsync($"{BaseApiUrl}/api/Admin/posts/{id}/status?status=Rejected", null);
        await LoadData();
    }

    private async Task ApproveReview(int id)
    {
        await Http.PatchAsync($"{BaseApiUrl}/api/Admin/reviews/{id}/approve", null);
        await LoadData();
    }

    private async Task RejectReview(int id)
    {
        await Http.DeleteAsync($"{BaseApiUrl}/api/Admin/reviews/{id}/reject");
        await LoadData();
    }

    private async Task ResolveOrder(Guid id, string decision, int complaintId)
    {
        // Обновляем URL, чтобы добавить complaintId
        var url = $"{BaseApiUrl}/api/Admin/orders/{id}/resolve?decision={decision}&complaintId={complaintId}";

        var res = await Http.PatchAsync(url, null);

        if (res.IsSuccessStatusCode)
        {
            await LoadData(); // Перезагружаем список, чтобы жалоба исчезла
        }
        else
        {
            // На всякий случай выведем ошибку в консоль, если что-то пойдет не так
            var error = await res.Content.ReadAsStringAsync();
            Console.WriteLine($"Ошибка арбитража: {error}");
        }
    }

    // Очистка при закрытии
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null) await hubConnection.DisposeAsync();
    }

    // DTO классы (те же самые)
    public class AdminPostDto { public int Id { get; set; } public string Content { get; set; } = ""; public string AuthorName { get; set; } = ""; }
    public class AdminReviewDto { public int Id { get; set; } public int Rating { get; set; } public string Comment { get; set; } = ""; public string ReviewerName { get; set; } = ""; public string EngineerName { get; set; } = ""; }
    public class AdminOrderDto { public Guid Id { get; set; } public decimal TotalAmount { get; set; } public string Customer { get; set; } = ""; public string Engineer { get; set; } = ""; }
    public class AdminComplaintDto
    {
        public int Id { get; set; }
        public string Reason { get; set; } = "";
        public string? Comment { get; set; }
        public DateTime CreatedAt { get; set; }
        public string SenderName { get; set; } = "";
        public string TargetName { get; set; } = "";
        public Guid? OrderId { get; set; }
        public decimal OrderAmount { get; set; }
    }
}