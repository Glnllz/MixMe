@page "/profile/edit"
@using MixMeShared
@using System.Net.Http.Headers
@inject HttpClient Http
@inject Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Фоновое свечение *@
<BackgroundGlow />

<div class="edit-scroll-container">
    <div class="profile-layout fade-in">
        <div class="glass-card edit-card">

            @* Шапка формы *@
            <div class="edit-header">
                <div class="header-icon">
                    <i class="bi bi-person-gear"></i>
                </div>
                <div>
                    <h2 class="text-pink">Настройки профиля</h2>
                    <p class="subtitle">Персонализируйте вашу страницу в MixMe</p>
                </div>
            </div>

            @if (user == null)
            {
                <div class="text-center p-5">
                    <span class="spinner-border text-pink"></span>
                </div>
            }
            else
            {
                <div class="edit-form">

                    @* --- АВАТАР --- *@
                    <div class="input-section text-center">
                        <div class="edit-avatar-wrapper">
                            @* Добавляем вызов GetFullUrl *@
                            <img src="@GetFullUrl(user.AvatarUrl)" class="edit-preview-avatar" />

                            <label for="avatarUpload" class="btn-change-photo">
                                <i class="bi bi-camera-fill me-2"></i> Изменить фото
                            </label>
                            <InputFile id="avatarUpload" OnChange="UploadAvatar" hidden accept="image/*" />
                        </div>
                    </div>

                    @* Поле: Имя *@
                    <div class="input-section">
                        <label><i class="bi bi-person-circle"></i> Полное имя</label>
                        <input type="text" class="modern-input" @bind="user.FullName" placeholder="Введите ваше имя" />
                    </div>

                    @if (user.RoleId == 2)
                    {
                        @* Поле: О себе *@
                        <div class="input-section">
                            <label><i class="bi bi-chat-quote"></i> О себе (Bio)</label>
                            <textarea class="modern-input" @bind="engineerDto.Bio" rows="4"
                                      placeholder="Расскажите о своем стиле, оборудовании и подходе к работе..."></textarea>
                        </div>

                        @* Поле: Опыт *@
                        <div class="input-section">
                            <label><i class="bi bi-clock-history"></i> Опыт работы (лет)</label>
                            <div class="number-input-wrapper">
                                <input type="number" class="modern-input" @bind="engineerDto.ExperienceYears" />
                            </div>
                        </div>

                        @* Поле: Жанры *@
                        <div class="input-section">
                            <label><i class="bi bi-music-note-beamed"></i> Ваша специализация (жанры)</label>
                            <div class="modern-genres">
                                @foreach (var genre in allGenres)
                                {
                                    <div class="m-genre-chip @(engineerDto.GenreIds.Contains(genre.Id) ? "active" : "")"
                                         @onclick="() => ToggleGenre(genre.Id)">
                                        @genre.Name
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Кнопки действий *@
                    <div class="edit-actions">
                        <button class="btn-main-pink" @onclick="SaveProfile" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check-lg"></i> Сохранить изменения
                        </button>

                        <button class="btn-ghost" @onclick='() => Nav.NavigateTo("/profile")'>
                            Отмена
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* КОНТЕЙНЕР СО СКРОЛЛОМ */
    .edit-scroll-container {
        height: 100vh;
        width: 100vw;
        overflow-y: auto;
        padding: 40px 20px;
        position: relative;
        z-index: 10;
        scroll-behavior: smooth;
    }

    /* КАРТОЧКА */
    .edit-card {
        max-width: 700px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(40px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 40px;
        padding: 50px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }

    /* АВАТАР В РЕДАКТИРОВАНИИ */
    .edit-avatar-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 30px;
    }

    .edit-preview-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #E91E63;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    .btn-change-photo {
        position: absolute;
        bottom: 0;
        right: 0;
        background: #E91E63;
        color: white;
        padding: 8px 16px;
        border-radius: 50px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 700;
        border: 2px solid #1a1a1a;
        transition: 0.3s;
    }

        .btn-change-photo:hover {
            transform: scale(1.05);
            background: #ff2e75;
        }

    /* Кнопка "Добавить работу" */
    .btn-add-work {
        background: rgba(233, 30, 99, 0.1);
        border: 1px dashed #E91E63;
        color: white;
        padding: 10px 20px;
        border-radius: 15px;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-add-work:hover {
            background: #E91E63;
            border-style: solid;
        }

    /* Стили модального окна */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        max-width: 500px;
        width: 90%;
        padding: 40px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .file-label {
        display: block;
        background: rgba(255,255,255,0.05);
        border: 2px dashed rgba(255,255,255,0.1);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        cursor: pointer;
        transition: 0.3s;
    }

        .file-label:hover {
            background: rgba(255,255,255,0.08);
        }

        .file-label.pink {
            border-color: rgba(233,30,99,0.3);
        }

    .file-status {
        font-size: 0.7rem;
        margin-top: 5px;
        color: #E91E63;
    }

    /* ФОРМА */
    .edit-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 40px;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        background: rgba(233, 30, 99, 0.1);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #E91E63;
    }

    .subtitle {
        color: rgba(255,255,255,0.4);
        margin: 0;
    }

    .input-section {
        margin-bottom: 25px;
    }

        .input-section label {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            color: rgba(255,255,255,0.6);
            font-weight: 600;
            font-size: 0.95rem;
        }

    .modern-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 15px 20px;
        color: white;
        outline: none;
        transition: 0.3s;
    }

        .modern-input:focus {
            border-color: #E91E63;
            box-shadow: 0 0 20px rgba(233, 30, 99, 0.15);
        }

    .modern-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .m-genre-chip {
        padding: 10px 20px;
        border-radius: 30px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        cursor: pointer;
        transition: 0.3s;
        font-size: 0.9rem;
        font-weight: 600;
    }

        .m-genre-chip.active {
            background: #E91E63;
            border-color: #E91E63;
        }

    .edit-actions {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-top: 40px;
    }

    .btn-main-pink {
        background: #E91E63;
        color: white;
        border: none;
        padding: 18px;
        border-radius: 18px;
        font-weight: 800;
        font-size: 1.1rem;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-main-pink:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(233, 30, 99, 0.4);
        }

    .btn-ghost {
        background: transparent;
        color: rgba(255,255,255,0.5);
        border: none;
        padding: 10px;
        font-weight: 600;
        cursor: pointer;
    }

    /* Кастомный скроллбар */
    .edit-scroll-container::-webkit-scrollbar {
        width: 8px;
    }

    .edit-scroll-container::-webkit-scrollbar-thumb {
        background: rgba(233, 30, 99, 0.3);
        border-radius: 10px;
    }

        .edit-scroll-container::-webkit-scrollbar-thumb:hover {
            background: #E91E63;
        }
</style>

@code {
    private UserProfile? user;
    private EngineerUpdateDto engineerDto = new();
    private List<Genre> allGenres = new();
    private bool isSaving = false;

    // Адрес вашего бэкенда (проверьте порт в Swagger)
    private string BaseApiUrl = "https://localhost:7237";

    protected override async Task OnInitializedAsync()
    {
        if (Auth.User == null) { Nav.NavigateTo("/login"); return; }

        try
        {
            // Используем полный путь для запросов, если HttpClient не настроен на BaseAddress
            user = await Http.GetFromJsonAsync<UserProfile>($"{BaseApiUrl}/api/profiles/{Auth.User.Id}");
            allGenres = await Http.GetFromJsonAsync<List<Genre>>($"{BaseApiUrl}/api/dictionary/genres") ?? new();

            if (user?.RoleId == 2)
            {
                var eng = await Http.GetFromJsonAsync<Engineer>($"{BaseApiUrl}/api/engineers/{Auth.User.Id}");
                if (eng != null)
                {
                    engineerDto.Bio = eng.Bio;
                    engineerDto.ExperienceYears = eng.ExperienceYears;
                    engineerDto.GenreIds = eng.Genres.Select(g => g.Id).ToList();
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка при загрузке: {ex.Message}"); }
    }

    // МЕТОД ДЛЯ ОТОБРАЖЕНИЯ ФОТО (используйте его в теге <img src="@GetFullUrl(user.AvatarUrl)" />)
    private string GetFullUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
            return "images/default-avatar.png"; // Путь к заглушке во фронтенде

        if (url.StartsWith("http")) return url;

        var separator = url.StartsWith("/") ? "" : "/";
        return $"{BaseApiUrl}{separator}{url}";
    }

    private async Task UploadAvatar(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10); // до 10 МБ
            var fileContent = new StreamContent(stream);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync($"{BaseApiUrl}/api/Files/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (user != null && result != null)
                {
                    // Сохраняем относительный путь (/uploads/...),
                    // метод GetFullUrl сам добавит домен для отображения
                    user.AvatarUrl = result.Url;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка загрузки файла: {ex.Message}"); }
    }

    private void ToggleGenre(int id)
    {
        if (engineerDto.GenreIds.Contains(id))
            engineerDto.GenreIds.Remove(id);
        else
            engineerDto.GenreIds.Add(id);
    }

    private async Task SaveProfile()
    {
        if (user == null) return;
        isSaving = true;
        try
        {
            await Http.PutAsJsonAsync($"{BaseApiUrl}/api/profiles/{user.Id}", user);
            if (user.RoleId == 2)
            {
                await Http.PutAsJsonAsync($"{BaseApiUrl}/api/engineers/{user.Id}", engineerDto);
            }
            Nav.NavigateTo("/profile");
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка сохранения: {ex.Message}"); }
        finally { isSaving = false; }
    }

    public class UploadResult { public string Url { get; set; } = ""; }
}