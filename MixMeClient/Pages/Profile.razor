@page "/profile"
@page "/profile/{UserId:guid}"
@using MixMeShared
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<BackgroundGlow />

@* Скрытый элемент аудио для глобального управления воспроизведением *@
<audio @ref="audioElement" src="@currentTrackUrl" @ontimeupdate="UpdateProgress"></audio>

<div class="profile-scroll-container">
    <div class="profile-content fade-in">

        @if (user == null)
        {
            <div class="text-center p-5">
                <span class="spinner-border text-pink"></span>
                <p class="mt-3 text-white-50">Загрузка профиля...</p>
            </div>
        }
        else
        {
            @* 1. ШАПКА ПРОФИЛЯ *@
            <section class="profile-header-premium">
                <div class="header-main">
                    <div class="avatar-container">
                        <img src="@(string.IsNullOrEmpty(user.AvatarUrl) ? "images/default-avatar.png" : (user.AvatarUrl.StartsWith("http") ? user.AvatarUrl : BaseApiUrl + user.AvatarUrl))" class="big-avatar" />
                        @if (Auth.User?.Id == user.Id)
                        {
                            <button class="change-avatar-btn" @onclick='() => Nav.NavigateTo("/profile/edit")' title="Сменить фото">
                                <i class="bi bi-camera"></i>
                            </button>
                        }
                    </div>
                    <div class="info">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge-role">@(user.RoleId == 2 ? "Engineer" : "Customer")</span>
                            @if (Auth.User?.Id == user.Id)
                            {
                                <button class="btn-edit-glass" @onclick='() => Nav.NavigateTo("/profile/edit")'>Редактировать</button>
                            }
                        </div>
                        <h1 class="username">@user.Username</h1>
                        <p class="fullname">@user.FullName</p>
                    </div>
                </div>
            </section>

            <div class="profile-grid">
                @* ЛЕВАЯ КОЛОНКА *@
                <aside>
                    <div class="glass-card-dark mb-4">
                        <h4 class="mb-3 text-pink">О специалисте</h4>
                        <p class="bio-text">@(engineerData?.Bio ?? "Информации пока нет")</p>
                        <div class="mini-stats">
                            <div class="stat"><i class="bi bi-star-fill"></i> @(engineerData?.AvgRating.ToString("F1") ?? "0.0")</div>
                            <div class="stat"><i class="bi bi-briefcase"></i> @(engineerData?.ExperienceYears ?? 0) лет</div>
                        </div>
                    </div>

                    <div class="glass-card-dark">
                        <h4 class="mb-3 text-pink">Активные проекты</h4>
                        <div class="project-list">
                            <div class="project-mini">
                                <span class="status-dot green"></span>
                                <div>
                                    <div class="p-name">Mixing: Synthwave Track</div>
                                    <div class="p-status">В работе</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>

                @* ПРАВАЯ КОЛОНКА (ПОРТФОЛИО) *@
                <main>
                    <div class="section-header">
                        <h3>Портфолио</h3>
                        @if (Auth.User?.Id == user.Id && user.RoleId == 2)
                        {
                            <button class="btn-add-work" @onclick="() => showAddPortfolioModal = true">
                                <i class="bi bi-plus-lg"></i> Добавить работу
                            </button>
                        }
                    </div>

                    @if (portfolioItems == null || !portfolioItems.Any())
                    {
                        <div class="glass-card-dark text-center p-5">
                            <i class="bi bi-music-note-list fs-1 text-white-50"></i>
                            <p class="mt-3">Портфолио пока пусто</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in portfolioItems)
                        {
                            <div class="portfolio-card-premium @(activeItem == item ? "active-track" : "")">
                                <div class="work-info">
                                    <h4>@item.Title</h4>
                                    <p>@item.Description</p>
                                </div>

                                <div class="ab-player">
                                    <div class="player-controls">
                                        <button class="play-btn" @onclick="() => TogglePlay(item)">
                                            <i class="bi @(isPlaying && activeItem == item ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                        <div class="track-visual">
                                            <div class="progress-bar" style="width: @(activeItem == item ? progressPercent : 0)%"></div>
                                        </div>
                                    </div>

                                    <div class="ab-toggle">
                                        <button class="toggle-btn @(!isAfterMode && activeItem == item ? "active" : "")"
                                                @onclick="() => SetMode(item, false)">
                                            BEFORE
                                        </button>
                                        <div class="switch @(isAfterMode && activeItem == item ? "right" : "")"></div>
                                        <button class="toggle-btn @(isAfterMode && activeItem == item ? "active" : "")"
                                                @onclick="() => SetMode(item, true)">
                                            AFTER
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </main>
            </div>
        }
    </div>
</div>

@* МОДАЛЬНОЕ ОКНО ДОБАВЛЕНИЯ РАБОТЫ *@
@if (showAddPortfolioModal)
{
    <div class="modal-backdrop">
        <div class="glass-card-dark modal-content fade-in">
            <h3 class="text-pink mb-4">Новая работа в портфолио</h3>

            <div class="mb-3">
                <label class="form-label text-white-50">Название трека</label>
                <input type="text" class="modern-input" @bind="newItem.Title" placeholder="Напр: Summer House Mix" />
            </div>

            <div class="mb-3">
                <label class="form-label text-white-50">Комментарий / Описание</label>
                <textarea class="modern-input" @bind="newItem.Description" placeholder="Что именно вы сделали с треком?"></textarea>
            </div>

            <div class="row mb-4">
                <div class="col">
                    <label class="file-label">
                        <i class="bi bi-cloud-upload"></i> Трек ДО
                        <InputFile OnChange="e => UploadAudio(e, true)" hidden accept="audio/*" />
                        <div class="file-status">@(string.IsNullOrEmpty(newItem.AudioBeforeUrl) ? "Не выбран" : "Готов ✅")</div>
                    </label>
                </div>
                <div class="col">
                    <label class="file-label pink">
                        <i class="bi bi-cloud-upload"></i> Трек ПОСЛЕ
                        <InputFile OnChange="e => UploadAudio(e, false)" hidden accept="audio/*" />
                        <div class="file-status">@(string.IsNullOrEmpty(newItem.AudioAfterUrl) ? "Не выбран" : "Готов ✅")</div>
                    </label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn-main-pink w-100" @onclick="SavePortfolioItem" disabled="@isUploading">
                    @if (isUploading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Опубликовать
                </button>
                <button class="btn-ghost" @onclick="() => showAddPortfolioModal = false">Отмена</button>
            </div>
        </div>
    </div>
}

<style>
    .profile-scroll-container {
        height: 100vh;
        width: 100vw;
        overflow-y: auto;
        padding-bottom: 100px;
        scroll-behavior: smooth;
    }

    .profile-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .profile-header-premium {
        background: linear-gradient(180deg, rgba(233, 30, 99, 0.25) 0%, rgba(18, 18, 18, 0) 100%);
        padding: 60px 40px;
        border-radius: 40px;
        margin-bottom: 40px;
    }

    .header-main {
        display: flex;
        align-items: flex-end;
        gap: 40px;
    }

    .big-avatar {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        border: 4px solid rgba(255,255,255,0.05);
    }

    .change-avatar-btn {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: #E91E63;
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 15px rgba(233, 30, 99, 0.4);
    }

    .username {
        font-size: 3.5rem;
        font-weight: 900;
        margin: 0;
        letter-spacing: -2px;
        color: white;
    }

    .badge-role {
        background: #E91E63;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 800;
        color: white;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 40px;
    }

    .glass-card-dark {
        background: rgba(20, 20, 20, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.05);
        padding: 25px;
        border-radius: 24px;
        color: white;
    }

    /* ПОРТФОЛИО КАРТОЧКА */
    .portfolio-card-premium {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 30px;
        padding: 30px;
        margin-bottom: 20px;
        transition: 0.3s;
        color: white;
    }

        .portfolio-card-premium.active-track {
            border-color: rgba(233, 30, 99, 0.4);
            background: rgba(233, 30, 99, 0.05);
        }

    /* ПЛЕЕР */
    .ab-player {
        background: rgba(0,0,0,0.2);
        padding: 20px;
        border-radius: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    .player-controls {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-grow: 1;
        margin-right: 30px;
    }

    .play-btn {
        background: #E91E63;
        border: none;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        color: white;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .play-btn:hover {
            transform: scale(1.1);
        }

    .track-visual {
        height: 6px;
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
        flex-grow: 1;
        position: relative;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: #E91E63;
        width: 0%;
        transition: width 0.1s linear;
    }

    /* ПЕРЕКЛЮЧАТЕЛЬ */
    .ab-toggle {
        display: flex;
        background: #111;
        padding: 5px;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,0.1);
        position: relative;
    }

    .toggle-btn {
        background: transparent;
        border: none;
        color: rgba(255,255,255,0.4);
        padding: 8px 15px;
        font-size: 0.75rem;
        font-weight: 800;
        cursor: pointer;
        position: relative;
        z-index: 2;
        transition: 0.3s;
    }

        .toggle-btn.active {
            color: white;
        }

    .switch {
        position: absolute;
        left: 5px;
        top: 5px;
        bottom: 5px;
        width: calc(50% - 5px);
        background: #E91E63;
        border-radius: 50px;
        transition: 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
        z-index: 1;
    }

        .switch.right {
            transform: translateX(100%);
        }

    /* МОДАЛКА */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        max-width: 500px;
        width: 95%;
    }

    .modern-input {
        width: 100%;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 12px;
        color: white;
        margin-top: 5px;
        outline: none;
    }

    .file-label {
        display: block;
        background: rgba(255,255,255,0.05);
        border: 2px dashed rgba(255,255,255,0.1);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        cursor: pointer;
        color: white;
    }

        .file-label.pink {
            border-color: rgba(233,30,99,0.3);
        }

    .file-status {
        font-size: 0.7rem;
        margin-top: 5px;
        color: #E91E63;
    }

    .btn-main-pink {
        background: #E91E63;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 12px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-ghost {
        background: transparent;
        border: none;
        color: white;
        opacity: 0.6;
    }
</style>

@code {
    private string BaseApiUrl = "https://localhost:7237"; // Замените на ваш порт бэкенда

    [Parameter] public Guid? UserId { get; set; }
    private UserProfile? user;
    private Engineer? engineerData;
    private List<PortfolioItem> portfolioItems = new();

    // Плеер
    private ElementReference audioElement;
    private string currentTrackUrl = "";
    private bool isPlaying = false;
    private bool isAfterMode = true;
    private PortfolioItem? activeItem;
    private double progressPercent = 0;

    // Модалка
    private bool showAddPortfolioModal = false;
    private bool isUploading = false;
    private PortfolioItem newItem = new();

    protected override async Task OnInitializedAsync()
    {
        Guid targetId = UserId ?? Auth.User?.Id ?? Guid.Empty;
        if (targetId == Guid.Empty) { Nav.NavigateTo("/login"); return; }

        try
        {
            user = await Http.GetFromJsonAsync<UserProfile>($"api/profiles/{targetId}");
            if (user?.RoleId == 2)
            {
                engineerData = await Http.GetFromJsonAsync<Engineer>($"api/engineers/{targetId}");
                portfolioItems = await Http.GetFromJsonAsync<List<PortfolioItem>>($"api/portfolios/engineer/{targetId}") ?? new();
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    // ЛОГИКА ПЛЕЕРА
    private async Task TogglePlay(PortfolioItem item)
    {
        if (activeItem != item)
        {
            activeItem = item;
            UpdateTrackUrl();
            await JS.InvokeVoidAsync("eval", "document.querySelector('audio').load()");
        }

        if (isPlaying) await JS.InvokeVoidAsync("eval", "document.querySelector('audio').pause()");
        else await JS.InvokeVoidAsync("eval", "document.querySelector('audio').play()");

        isPlaying = !isPlaying;
    }

    private void SetMode(PortfolioItem item, bool after)
    {
        bool wasPlaying = isPlaying;
        activeItem = item;
        isAfterMode = after;
        UpdateTrackUrl();

        // Бесшовное переключение времени
        JS.InvokeVoidAsync("eval", @"
            let a = document.querySelector('audio');
            let t = a.currentTime;
            a.load();
            a.onloadeddata = () => {
                a.currentTime = t;
                if(" + wasPlaying.ToString().ToLower() + @") a.play();
            }");
    }

    private void UpdateTrackUrl()
    {
        if (activeItem == null) return;
        var path = isAfterMode ? activeItem.AudioAfterUrl : activeItem.AudioBeforeUrl;
        currentTrackUrl = BaseApiUrl + path;
    }

    private async Task UpdateProgress()
    {
        var data = await JS.InvokeAsync<double[]>("eval", "let a = document.querySelector('audio'); [a.currentTime, a.duration]");
        if (data[1] > 0) progressPercent = (data[0] / data[1]) * 100;
        StateHasChanged();
    }

    // ЗАГРУЗКА ПОРТФОЛИО
    private async Task UploadAudio(InputFileChangeEventArgs e, bool isBefore)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(1024 * 1024 * 50));
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("api/Files/upload", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (isBefore) newItem.AudioBeforeUrl = result?.Url;
                else newItem.AudioAfterUrl = result?.Url;
            }
        }
        finally { isUploading = false; }
    }

    private async Task SavePortfolioItem()
    {
        if (string.IsNullOrEmpty(newItem.Title) || string.IsNullOrEmpty(newItem.AudioAfterUrl)) return;
        newItem.EngineerId = user!.Id;
        var response = await Http.PostAsJsonAsync("api/portfolios", newItem);
        if (response.IsSuccessStatusCode)
        {
            portfolioItems.Add(await response.Content.ReadFromJsonAsync<PortfolioItem>());
            showAddPortfolioModal = false;
            newItem = new();
        }
    }

    public class UploadResult { public string Url { get; set; } = ""; }
}