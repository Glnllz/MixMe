@page "/profile"
@page "/profile/{UserId:guid}"
@using MixMeShared
@using System.Net.Http.Json
@using System.Globalization
@using static MixMeClient.Pages.Orders
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<BackgroundGlow />

@* Аудио-движок для портфолио *@
<audio @ref="audioElement" src="@currentTrackUrl"
       @ontimeupdate="OnTimeUpdate"
       @onloadedmetadata="OnLoadedMetadata"
       @onended="() => isPlaying = false"></audio>

<div class="profile-container-full fade-in">
    <div class="profile-scroll-content">

        @if (user == null)
        {
            <div class="loader-box">
                <div class="spinner-premium"></div>
                <p>Загрузка профиля...</p>
            </div>
        }
        else
        {
            bool isEngineer = user.RoleId == 2;
            bool isOwnProfile = Auth.User?.Id == user.Id;

            @* --- ШАПКА ПРОФИЛЯ --- *@
            <header class="profile-hero-card">
                @if (isOwnProfile)
                {
                    <button class="top-logout-btn" @onclick="HandleLogout" title="Выйти из аккаунта">
                        <i class="bi bi-power"></i> <span>Выйти</span>
                    </button>
                }

                <div class="hero-layout">
                    <div class="hero-avatar-zone">
                        <div class="avatar-main-frame">
                            @if (string.IsNullOrEmpty(user.AvatarUrl))
                            {
                                <div class="avatar-placeholder"><i class="bi bi-person-fill"></i></div>
                            }
                            else
                            {
                                <img src="@GetAvatarUrl(user.AvatarUrl)" alt="Avatar" />
                            }

                            @if (isOwnProfile)
                            {
                                <div class="edit-badge" @onclick='() => Nav.NavigateTo("/profile/edit")'>
                                    <i class="bi bi-pencil-fill"></i>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="hero-info-zone">
                        <div class="badge-role @(isEngineer ? "" : "customer")">
                            <i class="bi @(isEngineer ? "bi-patch-check-fill" : "bi-person-check-fill")"></i>
                            @(isEngineer ? "Инженер" : "Заказчик")
                        </div>

                        <h1 class="user-name-title">@user.Username</h1>
                        <p class="user-full-name">@user.FullName</p>

                        @if (isEngineer && !isOwnProfile)
                        {
                            <div class="profile-actions-wrapper">
                                <button class="btn-order-main" @onclick="OpenOrderModal">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <span>Заказать услуги</span>
                                </button>
                                <button class="btn-chat-secondary" @onclick="OpenDirectChat">
                                    <i class="bi bi-chat-dots-fill"></i>
                                    <span>Написать</span>
                                </button>
                            </div>
                        }

                        @if (!isEngineer)
                        {
                            <div class="customer-since-box">
                                <i class="bi bi-calendar3"></i> На MixMe с @user.CreatedAt.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("ru-RU"))
                            </div>
                        }
                    </div>
                </div>
            </header>

            <div class="profile-grid-layout">
                <aside class="profile-sidebar">
                    <div class="info-glass-card">
                        <div class="info-header">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>@(isEngineer ? "О специалисте" : "О пользователе")</span>
                        </div>
                        <p class="info-text">@(isEngineer ? (engineerData?.Bio ?? "Инженер еще не заполнил биографию.") : "Пользователь MixMe. Ценит качественный звук.")</p>

                        @if (isEngineer && engineerData?.Genres != null && engineerData.Genres.Any())
                        {
                            <div class="tags-container">
                                @foreach (var g in engineerData.Genres)
                                {
                                    <span class="genre-tag">@g.Name</span>
                                }
                            </div>
                        }
                    </div>
                </aside>

                <section class="main-content-zone">
                    @if (isEngineer)
                    {
                        @* --- СТУДИЙНЫЙ ДАШБОРД СТАТИСТИКИ --- *@
                        @if (stats != null)
                        {
                            <div class="studio-dashboard animate__animated animate__fadeIn">
                                @* Публичные метрики *@
                                <div class="dashboard-glance">
                                    <div class="glance-item">
                                        <div class="g-icon"><i class="bi bi-star-fill text-gold"></i></div>
                                        <div class="g-text">
                                            <span class="g-val">@stats.AvgRating.ToString("F1")</span>
                                            <span class="g-lbl">Рейтинг</span>
                                        </div>
                                    </div>
                                    <div class="glance-item">
                                        <div class="g-icon"><i class="bi bi-check2-all text-pink"></i></div>
                                        <div class="g-text">
                                            <span class="g-val">@stats.TotalProjects</span>
                                            <span class="g-lbl">Проектов</span>
                                        </div>
                                    </div>
                                    <div class="glance-item">
                                        <div class="g-icon"><i class="bi bi-briefcase text-blue"></i></div>
                                        <div class="g-text">
                                            <span class="g-val">@stats.ExperienceYears <small>лет</small></span>
                                            <span class="g-lbl">Стаж</span>
                                        </div>
                                    </div>
                                </div>

                                @* Приватный финансовый блок *@
                                @if (isOwnProfile)
                                {
                                    <div class="dashboard-finance">
                                        <div class="finance-head">
                                            <span class="f-title"><i class="bi bi-graph-up-arrow me-2"></i> Финансовая динамика</span>
                                            <div class="f-total">Всего заработано: <span>@stats.IncomeHistory.Sum(x => x.Amount).ToString("N0") ₽</span></div>
                                        </div>

                                        @if (!stats.IncomeHistory.Any())
                                        {
                                            <div class="no-data-msg">Пока недостаточно данных для графика</div>
                                        }
                                        else
                                        {
                                            @* КОНТЕЙНЕР ДЛЯ ГРАФИКА *@
                                            <div class="chart-container-box">
                                                <canvas id="incomeChart"></canvas>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="loader-placeholder-stats">
                                <div class="spinner-border spinner-border-sm text-pink me-2"></div>
                                Загрузка аналитики профиля...
                            </div>
                        }
                        <div class="section-top">
                            <h3>Портфолио</h3>
                            @if (isOwnProfile)
                            {
                                <button class="btn-add-work-styled" @onclick="() => showAddPortfolioModal = true">
                                    <i class="bi bi-plus-lg"></i> Добавить работу
                                </button>
                            }
                        </div>

                        @if (!portfolioItems.Any())
                        {
                            <div class="empty-state"><i class="bi bi-music-note-beamed"></i><p>Список работ пуст</p></div>
                        }
                        else
                        {
                            @foreach (var item in portfolioItems)
                            {
                                var isThisActive = activeItem?.Id == item.Id;
                                var currentProgress = isThisActive ? progressPercent.ToString("F2", CultureInfo.InvariantCulture) : "0";

                                <div class="portfolio-card @(isThisActive ? "active-play" : "")">
                                    <div class="card-top">
                                        <div class="work-meta">
                                            <h4>@item.Title</h4>
                                            <p>@item.Description</p>
                                        </div>
                                        <div class="card-top-right">
                                            @if (isPlaying && isThisActive)
                                            {
                                                <div class="playing-waves"><span></span><span></span><span></span></div>
                                            }

                                            @* КНОПКА УДАЛЕНИЯ ДЛЯ ВЛАДЕЛЬЦА *@
                                            @if (isOwnProfile)
                                            {
                                                <button class="btn-del-work" @onclick="() => DeleteWork(item.Id)" title="Удалить работу">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="pro-audio-player">
                                        <button class="play-trigger" @onclick="() => TogglePlay(item)">
                                            <i class="bi @(isPlaying && isThisActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                        <div class="player-controls-area">
                                            <div class="seek-bar-container" @onclick="e => HandleSeek(e)">
                                                <div class="seek-bar-bg">
                                                    <div class="seek-bar-fill" style="width: @(currentProgress)%"></div>
                                                </div>
                                            </div>
                                            <div class="time-and-modes">
                                                <span class="time-display">@(isThisActive ? FormatTime(currentTime) : "0:00") / @(isThisActive ? FormatTime(duration) : "0:00")</span>
                                                <div class="ab-toggle">
                                                    <button class="ab-btn @(!isAfterMode && isThisActive ? "active" : "")" @onclick="() => SetMode(item, false)">До</button>
                                                    <button class="ab-btn pink @(isAfterMode && isThisActive ? "active" : "")" @onclick="() => SetMode(item, true)">После</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <section class="reviews-section mt-5">
                            <div class="section-top">
                                <h3>Отзывы клиентов (@reviews.Count)</h3>
                                <div class="avg-rating-big">
                                    <i class="bi bi-star-fill"></i> @(engineerData?.AvgRating.ToString("F1") ?? "0.0")
                                </div>
                            </div>

                            @if (!reviews.Any())
                            {
                                <div class="empty-reviews-glass">
                                    <i class="bi bi-chat-left-dots"></i>
                                    <p>У этого специалиста пока нет отзывов. Станьте первым!</p>
                                </div>
                            }
                            else
                            {
                                <div class="reviews-grid">
                                    @foreach (var review in reviews)
                                    {
                                        <div class="review-card-web animate__animated animate__fadeIn">
                                            <div class="review-header">
                                                @* Обертка для перехода в профиль *@
                                                <div class="d-flex align-items-center gap-2"
                                                     @onclick='() => Nav.NavigateTo($"/profile/{review.ReviewerId}")'
                                                     style="cursor: pointer;">

                                                    <div class="mini-ava-review">
                                                        @if (string.IsNullOrEmpty(review.ReviewerAvatarUrl))
                                                        {
                                                            <i class="bi bi-person-circle"></i>
                                                        }
                                                        else
                                                        {
                                                            <img src="@GetAvatarUrl(review.ReviewerAvatarUrl)"
                                                                 style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                                                        }
                                                    </div>
                                                    <span class="reviewer-name">@review.ReviewerName</span>
                                                </div>

                                                <div class="stars">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                    }
                                                </div>
                                            </div>
                                            <p class="review-comment">@review.Comment</p>
                                            <div class="review-footer">
                                                <span class="review-date">
                                                    <i class="bi bi-calendar-event me-1"></i>
                                                    @review.CreatedAt.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                </section>
            </div>
        }
    </div>
</div>

<MixMeClient.Pages.OrderModal @ref="orderModal" EngineerId="@(user?.Id ?? Guid.Empty)" EngineerName="@(user?.Username ?? "")" />

@if (showAddPortfolioModal)
{
    <div class="modal-overlay fade-in">
        <div class="modal-glass-card">
            <header class="modal-header-pro">
                <h3>Новая работа</h3>
                <button class="close-modal" @onclick="() => { showAddPortfolioModal = false; portfolioValidationError = null; }">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="modal-body-pro">
                @* Сообщение об ошибке *@
                @if (!string.IsNullOrEmpty(portfolioValidationError))
                {
                    <div class="alert-error-modal animate__animated animate__shakeX">
                        <i class="bi bi-exclamation-circle-fill me-2"></i> @portfolioValidationError
                    </div>
                }

                <div class="input-field">
                    <label>Название проекта</label>
                    <input type="text" @bind="newItem.Title"
                           class="@(string.IsNullOrEmpty(newItem.Title) && portfolioValidationError != null ? "input-invalid" : "")"
                           placeholder="Напр: Summer House Mix 2024" />
                </div>

                <div class="input-field">
                    <label>Описание</label>
                    <textarea @bind="newItem.Description" rows="2"
                              class="@(string.IsNullOrEmpty(newItem.Description) && portfolioValidationError != null ? "input-invalid" : "")"
                              placeholder="Расскажите о работе..."></textarea>
                </div>

                <div class="upload-grid-pro">
                    <label class="upload-zone @(string.IsNullOrEmpty(newItem.AudioBeforeUrl) ? "" : "completed")">
                        <i class="bi bi-cloud-upload"></i>
                        <span>ДО</span>
                        <InputFile OnChange="e => UploadAudio(e, true)" hidden accept="audio/*" />
                    </label>

                    <label class="upload-zone pink @(string.IsNullOrEmpty(newItem.AudioAfterUrl) ? "" : "completed") @(string.IsNullOrEmpty(newItem.AudioAfterUrl) && portfolioValidationError != null ? "zone-invalid" : "")">
                        <i class="bi bi-cloud-check"></i>
                        <span>ПОСЛЕ</span>
                        <InputFile OnChange="e => UploadAudio(e, false)" hidden accept="audio/*" />
                    </label>
                </div>
            </div>

            <footer class="modal-footer-pro">
                <button class="btn-save-pro" @onclick="SavePortfolioItem" disabled="@isUploading">
                    @if (isUploading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Опубликовать работу
                </button>
            </footer>
        </div>
    </div>
}
@* МОДАЛЬНОЕ ОКНО ПРЕДЛОЖЕНИЯ УСЛУГ (ИНЖЕНЕР -> ЗАКАЗЧИК) *@
@if (showOfferModal)
{
    <div class="modal-overlay fade-in">
        <div class="modal-glass-card">
            <header class="modal-header-pro">
                <h3>Сделать предложение</h3>
                <button class="close-modal" @onclick="() => showOfferModal = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </header>

            <div class="modal-body-pro">
                <p class="text-muted small mb-4">
                    Вы предлагаете услуги пользователю <strong>@user?.Username</strong>.
                    После отправки будет создан проект, который заказчик сможет оплатить.
                </p>

                <div class="input-field">
                    <label>Название услуги</label>
                    <input type="text" @bind="offerServiceName" placeholder="Напр. Сведение и мастеринг" />
                </div>

                <div class="input-field">
                    <label>Стоимость (₽)</label>
                    <input type="number" @bind="offerPrice" />
                </div>
            </div>

            <footer class="modal-footer-pro">
                <button class="btn-save-pro" @onclick="SendOfferToCustomer" disabled="@isSendingOffer">
                    @if (isSendingOffer)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Отправка...</span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill me-2"></i>
                        <span>Отправить предложение</span>
                    }
                </button>
            </footer>
        </div>
    </div>
}

<style>
    /* --- ГЛОБАЛЬНЫЙ КОНТЕЙНЕР И СКРОЛЛБАР --- */
    .profile-container-full {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow-y: auto;
        padding-top: 80px;
        z-index: 10;
        background: transparent;
    }

        .profile-container-full::-webkit-scrollbar {
            width: 8px;
        }

        .profile-container-full::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }

        .profile-container-full::-webkit-scrollbar-thumb {
            background: rgba(233, 30, 99, 0.3);
            border-radius: 10px;
        }

            .profile-container-full::-webkit-scrollbar-thumb:hover {
                background: #E91E63;
            }

    .profile-scroll-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px 100px;
    }

    /* --- ГЕРОЙ И ШАПКА --- */
    .profile-hero-card {
        background: rgba(20, 20, 20, 0.7);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 40px;
        padding: 40px;
        margin-bottom: 40px;
        position: relative;
    }

    .top-logout-btn {
        position: absolute;
        top: 25px;
        right: 30px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.4);
        padding: 8px 15px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 700;
        transition: 0.3s;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .top-logout-btn:hover {
            color: #E91E63;
            border-color: #E91E63;
            background: rgba(233,30,99,0.05);
        }

    .hero-layout {
        display: flex;
        gap: 40px;
        align-items: center;
    }

    .avatar-main-frame {
        width: 180px;
        height: 180px;
        border-radius: 50px;
        overflow: hidden;
        border: 3px solid #E91E63;
        position: relative;
        background: #1a1a1a;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

        .avatar-main-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #222;
        color: #444;
        font-size: 5rem;
    }

    .edit-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: #E91E63;
        width: 35px;
        height: 35px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid #141414;
    }

    .user-name-title {
        font-size: 3.5rem;
        font-weight: 900;
        margin: 0;
        letter-spacing: -2px;
        color: white;
    }

    .user-full-name {
        color: rgba(255,255,255,0.5);
        font-size: 1.2rem;
        margin-top: -5px;
    }

    .badge-role {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(233, 30, 99, 0.15);
        color: #E91E63;
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

        .badge-role.customer {
            background: rgba(0, 188, 212, 0.15);
            color: #00bcd4;
        }

    .stats-grid {
        display: flex;
        gap: 40px;
        margin-top: 30px;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 900;
        color: white;
    }

    .stat-label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        font-weight: 700;
    }

    .stat-item.rating .stat-value {
        color: #FFC107;
    }

    .customer-since-box {
        margin-top: 25px;
        color: rgba(255,255,255,0.3);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .card-top-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    /* КНОПКА УДАЛЕНИЯ */
    .btn-del-work {
        background: rgba(255, 82, 82, 0.1);
        border: 1px solid rgba(255, 82, 82, 0.2);
        color: #ff5252;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-del-work:hover {
            background: #ff5252;
            color: white;
            transform: scale(1.1);
            box-shadow: 0 5px 15px rgba(255, 82, 82, 0.3);
        }

    .mini-ava-review {
        width: 36px;
        height: 36px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--pink);
        overflow: hidden; /* Чтобы картинка не вылезала за края */
        border: 1px solid rgba(233, 30, 99, 0.2);
        transition: 0.3s;
    }

    /* Эффект при наведении на автора отзыва */
    .review-header .d-flex:hover .reviewer-name {
        color: #ff2e75;
        text-decoration: underline;
    }

    .review-header .d-flex:hover .mini-ava-review {
        transform: scale(1.1);
        border-color: var(--pink);
    }

    .review-card-web {
        background: rgba(255,255,255,0.03) !important;
        border: 1px solid rgba(255,255,255,0.05) !important;
        padding: 20px !important;
        border-radius: 20px !important;
        margin-bottom: 15px;
    }

    .review-footer {
        border-top: 1px solid rgba(255,255,255,0.05);
        margin-top: 10px;
        padding-top: 10px;
    }
    /* --- СЕТКА И КАРТОЧКИ --- */
    .profile-grid-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 40px;
    }

    .info-glass-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 30px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .info-header {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #E91E63;
        font-weight: 800;
        font-size: 0.9rem;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

        .info-header.blue {
            color: #00bcd4;
        }

    .info-text {
        color: rgba(255,255,255,0.7);
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .genre-tag {
        display: inline-block;
        padding: 6px 14px;
        background: rgba(255,255,255,0.05);
        border-radius: 8px;
        margin-right: 10px;
        margin-bottom: 10px;
        font-size: 0.8rem;
        color: white;
    }

    /* --- ПОРТФОЛИО И ПЛЕЕР --- */
