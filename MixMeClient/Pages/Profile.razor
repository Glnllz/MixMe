@code {
    private string BaseApiUrl = "https://localhost:7237";

    [Parameter] public Guid? UserId { get; set; }
    private UserProfile? user;
    private Engineer? engineerData;
    private List<PortfolioItem> portfolioItems = new();

    private ElementReference audioElement;
    private string currentTrackUrl = "";
    private bool isPlaying = false;
    private bool isAfterMode = true;
    private PortfolioItem? activeItem;

    private double currentTime = 0;
    private double duration = 0;
    private double progressPercent => duration > 0 ? (currentTime / duration) * 100 : 0;

    private bool showAddPortfolioModal = false;
    private bool isUploading = false;
    private PortfolioItem newItem = new();

    protected override async Task OnInitializedAsync()
    {
        Guid targetId = UserId ?? Auth.User?.Id ?? Guid.Empty;
        if (targetId == Guid.Empty) { Nav.NavigateTo("/login"); return; }

        try
        {
            user = await Http.GetFromJsonAsync<UserProfile>($"{BaseApiUrl}/api/profiles/{targetId}");
            if (user?.RoleId == 2)
            {
                engineerData = await Http.GetFromJsonAsync<Engineer>($"{BaseApiUrl}/api/engineers/{targetId}");
                portfolioItems = await Http.GetFromJsonAsync<List<PortfolioItem>>($"{BaseApiUrl}/api/portfolios/engineer/{targetId}") ?? new();
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    private string GetAvatarUrl(string? url) =>
        string.IsNullOrEmpty(url) ? "images/default-avatar.png" :
        (url.StartsWith("http") ? url : BaseApiUrl + "/" + url.TrimStart('/'));

    private async Task TogglePlay(PortfolioItem item)
    {
        if (activeItem?.Id != item.Id)
        {
            activeItem = item;
            UpdateTrackUrl();
            await Task.Delay(50);
            await JS.InvokeVoidAsync("eval", "document.querySelector('audio').load()");
        }

        if (isPlaying) await JS.InvokeVoidAsync("eval", "document.querySelector('audio').pause()");
        else await JS.InvokeVoidAsync("eval", "document.querySelector('audio').play()");

        isPlaying = !isPlaying;
    }

    private async Task HandleSeek(MouseEventArgs e)
    {
        if (activeItem == null || duration <= 0) return;

        var seekData = await JS.InvokeAsync<double[]>("eval", @"
            (function() {
                let rect = document.querySelector('.seek-bar-bg').getBoundingClientRect();
                return [" + e.ClientX + @" - rect.left, rect.width];
            })()");

        double clickX = seekData[0];
        double width = seekData[1];
        double newTime = (clickX / width) * duration;

        await JS.InvokeVoidAsync("eval", $"document.querySelector('audio').currentTime = {newTime.ToString(CultureInfo.InvariantCulture)}");
    }

    private async Task OnTimeUpdate()
    {
        var time = await JS.InvokeAsync<double>("eval", "document.querySelector('audio').currentTime");
        if (Math.Abs(currentTime - time) > 0.1)
        {
            currentTime = time;
            StateHasChanged();
        }
    }

    private async Task OnLoadedMetadata()
    {
        duration = await JS.InvokeAsync<double>("eval", "document.querySelector('audio').duration");
        StateHasChanged();
    }

    private void SetMode(PortfolioItem item, bool after)
    {
        activeItem = item;
        isAfterMode = after;
        UpdateTrackUrl();

        JS.InvokeVoidAsync("eval", @"
            let a = document.querySelector('audio');
            let t = a.currentTime;
            a.load();
            a.onloadeddata = () => { a.currentTime = t; a.play(); }");

        isPlaying = true;
    }

    private void UpdateTrackUrl()
    {
        if (activeItem == null) return;
        var path = isAfterMode ? activeItem.AudioAfterUrl : activeItem.AudioBeforeUrl;
        currentTrackUrl = path.StartsWith("http") ? path : BaseApiUrl + "/" + path.TrimStart('/');
    }

    private string FormatTime(double seconds)
    {
        var time = TimeSpan.FromSeconds(seconds);
        return $"{(int)time.TotalMinutes}:{time.Seconds:D2}";
    }

    private async Task UploadAudio(InputFileChangeEventArgs e, bool isBefore)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(1024 * 1024 * 50));
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync($"{BaseApiUrl}/api/Files/upload", content);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                if (isBefore) newItem.AudioBeforeUrl = result?.Url;
                else newItem.AudioAfterUrl = result?.Url;
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isUploading = false; }
    }

    private async Task SavePortfolioItem()
    {
        if (string.IsNullOrEmpty(newItem.Title) || string.IsNullOrEmpty(newItem.AudioAfterUrl)) return;
        newItem.EngineerId = user!.Id;

        var response = await Http.PostAsJsonAsync($"{BaseApiUrl}/api/portfolios", newItem);
        if (response.IsSuccessStatusCode)
        {
            var saved = await response.Content.ReadFromJsonAsync<PortfolioItem>();
            if (saved != null) portfolioItems.Insert(0, saved);
            showAddPortfolioModal = false;
            newItem = new();
        }
    }

    public class UploadResult { public string Url { get; set; } = ""; }
}