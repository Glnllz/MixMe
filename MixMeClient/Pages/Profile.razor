@code {
    private MixMeClient.Pages.OrderModal orderModal = default!;
    private string BaseApiUrl = "https://localhost:7237";

    [Parameter][SupplyParameterFromQuery] public string? action { get; set; }
    [Parameter] public Guid? UserId { get; set; }

    private UserProfile? user;
    private Engineer? engineerData;
    private int completedOrdersCount = 0; // Новая переменная для статистики
    private List<PortfolioItem> portfolioItems = new();
    private List<ReviewDto> reviews = new();
    private EngineerStatsDto? stats;

    private ElementReference audioElement;
    private string currentTrackUrl = "";
    private bool isPlaying = false, isAfterMode = true, showAddPortfolioModal = false, isUploading = false;
    private PortfolioItem? activeItem;
    private double currentTime = 0, duration = 0;
    private double progressPercent => duration > 0 ? (currentTime / duration) * 100 : 0;
    private PortfolioItem newItem = new();

    private bool showOfferModal = false;
    private string offerServiceName = "Сведение и мастеринг";
    private decimal offerPrice = 5000;
    private bool isSendingOffer = false;
    private string? portfolioValidationError;

    // Срабатывает каждый раз при инициализации или смене ID в URL
    protected override async Task OnParametersSetAsync()
    {
        // 1. Сброс данных для лоадера
        user = null;
        engineerData = null;
        stats = null;
        completedOrdersCount = 0;
        portfolioItems = new();
        reviews = new();
        activeItem = null;
        isPlaying = false;
        currentTrackUrl = "";

        // 2. Определение целевого ID
        if (UserId == null && Auth.User == null) return;
        Guid targetId = UserId ?? Auth.User?.Id ?? Guid.Empty;

        if (targetId == Guid.Empty)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            // 3. Загрузка основного профиля
            user = await Http.GetFromJsonAsync<UserProfile>($"{BaseApiUrl}/api/profiles/{targetId}");

            if (user?.RoleId == 2)
            {
                var engResponse = await Http.GetFromJsonAsync<EngineerWrapper>($"{BaseApiUrl}/api/engineers/{targetId}");
                if (engResponse != null)
                {
                    engineerData = engResponse.Data;
                    completedOrdersCount = engResponse.CompletedOrdersCount;
                }

                // Загружаем статистику
                stats = await Http.GetFromJsonAsync<EngineerStatsDto>($"{BaseApiUrl}/api/engineers/{targetId}/stats");

                portfolioItems = await Http.GetFromJsonAsync<List<PortfolioItem>>($"{BaseApiUrl}/api/portfolios/engineer/{targetId}") ?? new();
                reviews = await Http.GetFromJsonAsync<List<ReviewDto>>($"{BaseApiUrl}/api/reviews/engineer/{targetId}") ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке профиля: {ex.Message}");
        }

        // Логика открытия модалки предложения
        if (action == "offer" && Auth.User?.RoleId == 2 && user?.RoleId == 1)
        {
            showOfferModal = true;
        }

        // --- ОТРИСОВКА ГРАФИКА ---
        if (user?.RoleId == 2 && stats != null && stats.IncomeHistory.Any())
        {
            // ВАЖНО: Принудительно просим Blazor обновить UI, чтобы появился <canvas>
            StateHasChanged();

            // Ждем чуть дольше (200мс), чтобы браузер успел отрисовать DOM элементы
            await Task.Delay(200);

            // Вызываем JS
            await RenderChart();
        }
    }

    private async Task RenderChart()
    {
        if (stats != null && stats.IncomeHistory.Any())
        {
            // Подготавливаем данные: переворачиваем список, чтобы шел от старых к новым
            var history = stats.IncomeHistory.AsEnumerable().Reverse().ToList();
            var labels = history.Select(h => h.MonthName).ToArray();
            var data = history.Select(h => (double)h.Amount).ToArray();

            // Вызываем наш JS скрипт
            await JS.InvokeVoidAsync("renderIncomeChart", labels, data);
        }
    }

    private double CalculateBarWidth(decimal amount)
    {
        if (stats == null || !stats.IncomeHistory.Any()) return 0;
        // Находим максимальный доход среди месяцев, чтобы сделать его 100% ширины
        var maxAmount = stats.IncomeHistory.Max(x => x.Amount);
        if (maxAmount == 0) return 0;
        return (double)(amount / maxAmount) * 100;
    }

    private async Task DeleteWork(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Вы уверены, что хотите удалить эту работу из портфолио?")) return;

        try
        {
            var res = await Http.DeleteAsync($"{BaseApiUrl}/api/portfolios/{id}");
            if (res.IsSuccessStatusCode)
            {
                portfolioItems.RemoveAll(p => p.Id == id);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка удаления: {ex.Message}");
        }
    }

    private async Task HandleLogout() { await Auth.Logout(); Nav.NavigateTo("/"); }

    private string GetAvatarUrl(string? url) =>
        string.IsNullOrEmpty(url) ? "" : (url.StartsWith("http") ? url : BaseApiUrl + "/" + url.TrimStart('/'));

    private string FormatTime(double sec) => TimeSpan.FromSeconds(sec).ToString(@"m\:ss");

    private async Task TogglePlay(PortfolioItem item)
    {
        if (activeItem?.Id != item.Id)
        {
            activeItem = item;
            UpdateTrackUrl();
            await Task.Delay(50);
            await JS.InvokeVoidAsync("eval", "document.querySelector('audio').load()");
        }

        if (isPlaying) await JS.InvokeVoidAsync("eval", "document.querySelector('audio').pause()");
        else await JS.InvokeVoidAsync("eval", "document.querySelector('audio').play()");

        isPlaying = !isPlaying;
    }

    private async Task HandleSeek(MouseEventArgs e)
    {
        if (activeItem == null || duration <= 0) return;
        var data = await JS.InvokeAsync<double[]>("eval", "(function(){let r=document.querySelector('.seek-bar-bg').getBoundingClientRect();return [r.left, r.width];})()");
        double newTime = ((e.ClientX - data[0]) / data[1]) * duration;
        await JS.InvokeVoidAsync("eval", $"document.querySelector('audio').currentTime = {newTime.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
    }

    private async Task OnTimeUpdate()
    {
        var t = await JS.InvokeAsync<double>("eval", "document.querySelector('audio').currentTime");
        if (Math.Abs(currentTime - t) > 0.1)
        {
            currentTime = t;
            StateHasChanged();
        }
    }

    private async Task OnLoadedMetadata()
    {
        duration = await JS.InvokeAsync<double>("eval", "document.querySelector('audio').duration");
        StateHasChanged();
    }

    private void SetMode(PortfolioItem item, bool after)
    {
        activeItem = item;
        isAfterMode = after;
        UpdateTrackUrl();
        JS.InvokeVoidAsync("eval", "let a=document.querySelector('audio');let t=a.currentTime;a.load();a.onloadeddata=()=>{a.currentTime=t;a.play();}");
        isPlaying = true;
    }

    private void UpdateTrackUrl()
    {
        if (activeItem == null) return;
        var p = isAfterMode ? activeItem.AudioAfterUrl : activeItem.AudioBeforeUrl;
        if (string.IsNullOrEmpty(p)) return;
        currentTrackUrl = p.StartsWith("http") ? p : BaseApiUrl + "/" + p.TrimStart('/');
    }

    private async Task UploadAudio(InputFileChangeEventArgs e, bool isBefore)
    {
        isUploading = true;
        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new StreamContent(e.File.OpenReadStream(50 * 1024 * 1024)), "file", e.File.Name);
            var res = await Http.PostAsync($"{BaseApiUrl}/api/Files/upload", content);
            if (res.IsSuccessStatusCode)
            {
                var r = await res.Content.ReadFromJsonAsync<UploadResult>();
                if (isBefore) newItem.AudioBeforeUrl = r?.Url; else newItem.AudioAfterUrl = r?.Url;
            }
        }
        finally { isUploading = false; }
    }

  // Переменная для текста ошибки

    private async Task SavePortfolioItem()
    {
        // Сбрасываем ошибку перед проверкой
        portfolioValidationError = null;

        // --- ВАЛИДАЦИЯ ---
        if (string.IsNullOrWhiteSpace(newItem.Title))
        {
            portfolioValidationError = "Укажите название проекта (например, название песни).";
            return;
        }

        if (string.IsNullOrWhiteSpace(newItem.Description))
        {
            portfolioValidationError = "Добавьте краткое описание (DAW, плагины или жанр).";
            return;
        }

        if (string.IsNullOrEmpty(newItem.AudioAfterUrl))
        {
            portfolioValidationError = "Нужно обязательно загрузить итоговый результат (кнопка ПОСЛЕ).";
            return;
        }

        // Если "ДО" не обязательно, можно пропустить, но лучше хотя бы предупредить
        if (string.IsNullOrEmpty(newItem.AudioBeforeUrl))
        {
            // Если хочешь сделать "ДО" обязательным — раскомментируй:
            portfolioValidationError = "Загрузите исходник (кнопка ДО) для сравнения.";
            return;
        }

        // --- ЕСЛИ ВСЕ ОК, СОХРАНЯЕМ ---
        isUploading = true; // Блокируем кнопку на время запроса
        try
        {
            newItem.EngineerId = user!.Id;
            var res = await Http.PostAsJsonAsync($"{BaseApiUrl}/api/portfolios", newItem);
            if (res.IsSuccessStatusCode)
            {
                var s = await res.Content.ReadFromJsonAsync<PortfolioItem>();
                if (s != null) portfolioItems.Insert(0, s);
                showAddPortfolioModal = false;
                newItem = new(); // Очищаем форму
            }
            else
            {
                portfolioValidationError = "Ошибка сервера при сохранении. Попробуйте позже.";
            }
        }
        catch (Exception ex)
        {
            portfolioValidationError = "Ошибка сети. Проверьте соединение.";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task OpenDirectChat()
    {
        if (user == null || Auth.User == null) return;

        try
        {
            // 1. Загружаем все заказы текущего пользователя через API
            var allOrders = await Http.GetFromJsonAsync<List<MixMeClient.Pages.Orders.OrderViewModel>>(
                $"{BaseApiUrl}/api/orders/user/{Auth.User.Id}?requesterId={Auth.User.Id}");

            // 2. Ищем, есть ли хоть один заказ, где партнером выступает текущий liza (или другой профиль)
            var existingOrder = allOrders?.FirstOrDefault(o => o.PartnerName == user.Username);

            if (existingOrder != null)
            {
                // Если заказ/чат найден — переходим прямо в него
                Nav.NavigateTo($"/order/{existingOrder.Id}");
            }
            else
            {
                // Если заказов нет — выводим красивое подтверждение
                bool confirmOrder = await JS.InvokeAsync<bool>("confirm",
                    $"Для того чтобы написать {user.Username}, нужно выбрать одну из услуг. Открыть список услуг?");

                if (confirmOrder)
                {
                    OpenOrderModal(); // Открываем окно выбора услуги
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при поиске чата: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Не удалось загрузить список сообщений. Попробуйте позже.");
        }
    }

    private void OpenOrderModal()
    {
        if (orderModal != null && user != null)
        {
            orderModal.Show(user.Id, user.Username);
        }
    }

    private async Task SendOfferToCustomer()
    {
        if (user == null || Auth.User == null) return;
        if (string.IsNullOrWhiteSpace(offerServiceName) || offerPrice <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Введите название услуги и корректную цену");
            return;
        }

        isSendingOffer = true;

        // Создаем объект заказа (укажите ServiceId = 0 или любой ID по умолчанию для кастомных предложений)
        var dto = new
        {
            CustomerId = user.Id,
            EngineerId = Auth.User.Id,
            ServiceId = 1, // Или другой ID из вашей БД
            TotalAmount = offerPrice
        };

        try
        {
            var res = await Http.PostAsJsonAsync($"{BaseApiUrl}/api/orders/create", dto);
            if (res.IsSuccessStatusCode)
            {
                var newOrderId = await res.Content.ReadFromJsonAsync<Guid>();
                showOfferModal = false;
                // Переходим в созданный чат заказа
                Nav.NavigateTo($"/order/{newOrderId}");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Ошибка при создании предложения");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSendingOffer = false;
        }
    }

