@page "/profile"
@page "/profile/{UserId:guid}"
@using MixMeShared
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<BackgroundGlow />

@* Скрытый элемент аудио *@
<audio @ref="audioElement" src="@currentTrackUrl"
       @ontimeupdate="OnTimeUpdate"
       @onloadedmetadata="OnLoadedMetadata"
       @onended="() => isPlaying = false"></audio>

<div class="profile-container-full fade-in">
    <div class="profile-scroll-content">

        @if (user == null)
        {
            <div class="loader-box">
                <div class="spinner-premium"></div>
                <p>Загрузка профиля...</p>
            </div>
        }
        else
        {
            @* --- ШАПКА ПРОФИЛЯ (HERO) --- *@
            <header class="profile-hero-card">
                <div class="hero-layout">
                    <div class="hero-avatar-zone">
                        <div class="avatar-main-frame">
                            <img src="@GetAvatarUrl(user.AvatarUrl)" alt="Avatar" />
                            @if (Auth.User?.Id == user.Id)
                            {
                                <div class="edit-badge" @onclick='() => Nav.NavigateTo("/profile/edit")'>
                                    <i class="bi bi-pencil-fill"></i>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="hero-info-zone">
                        <div class="badge-role">
                            <i class="bi bi-patch-check-fill"></i> @(user.RoleId == 2 ? "Professional Engineer" : "Verified Customer")
                        </div>
                        <h1 class="user-name-title">@user.Username</h1>
                        <p class="user-full-name">@user.FullName</p>

                        <div class="stats-grid">
                            <div class="stat-item">
                                <span class="stat-value">@(portfolioItems?.Count ?? 0)</span>
                                <span class="stat-label">Работ</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-value">@(engineerData?.ExperienceYears ?? 0)</span>
                                <span class="stat-label">Лет опыта</span>
                            </div>
                            <div class="stat-item rating">
                                <span class="stat-value"><i class="bi bi-star-fill"></i> @(engineerData?.AvgRating.ToString("F1") ?? "0.0")</span>
                                <span class="stat-label">Рейтинг</span>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="profile-grid-layout">
                @* --- ЛЕВАЯ КОЛОНКА (ИНФО) --- *@
                <aside class="profile-sidebar">
                    <div class="info-glass-card">
                        <div class="info-header">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>О специалисте</span>
                        </div>
                        <p class="info-text">@(engineerData?.Bio ?? "Инженер еще не заполнил биографию.")</p>

                        @if (engineerData?.Genres != null && engineerData.Genres.Any())
                        {
                            <div class="tags-container">
                                @foreach (var g in engineerData.Genres)
                                {
                                    <span class="genre-tag">@g.Name</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="info-glass-card">
                        <div class="info-header pink">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Безопасность</span>
                        </div>
                        <p class="info-text small">MixMe защищает ваши средства. Оплата холдируется и переводится инженеру только после вашего финального одобрения результата.</p>
                    </div>
                </aside>

                @* --- ЦЕНТРАЛЬНАЯ ЧАСТЬ (ПОРТФОЛИО) --- *@
                <section class="portfolio-section">
                    <div class="section-top">
                        <h3>Портфолио</h3>
                        @if (Auth.User?.Id == user.Id && user.RoleId == 2)
                        {
                            <button class="btn-add-work" @onclick="() => showAddPortfolioModal = true">
                                <i class="bi bi-plus-lg"></i> Добавить работу
                            </button>
                        }
                    </div>

                    @if (portfolioItems == null || !portfolioItems.Any())
                    {
                        <div class="empty-portfolio">
                            <i class="bi bi-music-note-beamed"></i>
                            <p>Список работ пуст</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in portfolioItems)
                        {
                            var isThisActive = activeItem?.Id == item.Id;
                            var currentProgress = isThisActive ? progressPercent.ToString("F2", CultureInfo.InvariantCulture) : "0";

                            <div class="portfolio-card @(isThisActive ? "active-play" : "")">
                                <div class="card-top">
                                    <div class="work-meta">
                                        <h4>@item.Title</h4>
                                        <p>@item.Description</p>
                                    </div>
                                    @if (isPlaying && isThisActive)
                                    {
                                        <div class="playing-waves">
                                            <span></span><span></span><span></span>
                                        </div>
                                    }
                                </div>

                                <div class="pro-audio-player">
                                    <button class="play-trigger" @onclick="() => TogglePlay(item)">
                                        <i class="bi @(isPlaying && isThisActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                    </button>

                                    <div class="player-controls-area">
                                        @* Прогресс-бар с перемоткой *@
                                        <div class="seek-bar-container" @onclick="e => HandleSeek(e)">
                                            <div class="seek-bar-bg">
                                                <div class="seek-bar-fill" style="width: @(currentProgress)%"></div>
                                                <div class="seek-handle" style="left: @(currentProgress)%"></div>
                                            </div>
                                        </div>

                                        <div class="time-and-modes">
                                            <span class="time-display">
                                                @(isThisActive ? FormatTime(currentTime) : "0:00") / @(isThisActive ? FormatTime(duration) : "0:00")
                                            </span>

                                            <div class="ab-toggle">
                                                <button class="ab-btn @(!isAfterMode && isThisActive ? "active" : "")"
                                                        @onclick="() => SetMode(item, false)">
                                                    BEFORE
                                                </button>
                                                <button class="ab-btn pink @(isAfterMode && isThisActive ? "active" : "")"
                                                        @onclick="() => SetMode(item, true)">
                                                    AFTER
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </section>
            </div>
        }
    </div>
</div>

@* МОДАЛКА ДОБАВЛЕНИЯ *@
@if (showAddPortfolioModal)
{
    <div class="modal-overlay fade-in">
        <div class="modal-glass-card">
            <header class="modal-header-pro">
                <h3>Новая работа</h3>
                <button class="close-modal" @onclick="() => showAddPortfolioModal = false"><i class="bi bi-x-lg"></i></button>
            </header>

            <div class="modal-body-pro">
                <div class="input-field">
                    <label>Название проекта</label>
                    <input type="text" @bind="newItem.Title" placeholder="Напр: Deep House Mix 2024" />
                </div>
                <div class="input-field">
                    <label>Описание проделанной работы</label>
                    <textarea @bind="newItem.Description" rows="3" placeholder="Расскажите о нюансах сведения..."></textarea>
                </div>

                <div class="upload-grid-pro">
                    <label class="upload-zone @(string.IsNullOrEmpty(newItem.AudioBeforeUrl) ? "" : "completed")">
                        <i class="bi @(string.IsNullOrEmpty(newItem.AudioBeforeUrl) ? "bi-cloud-upload" : "bi-check-circle-fill")"></i>
                        <span>Трек ДО</span>
                        <InputFile OnChange="e => UploadAudio(e, true)" hidden accept="audio/*" />
                    </label>
                    <label class="upload-zone pink @(string.IsNullOrEmpty(newItem.AudioAfterUrl) ? "" : "completed")">
                        <i class="bi @(string.IsNullOrEmpty(newItem.AudioAfterUrl) ? "bi-cloud-check" : "bi-check-circle-fill")"></i>
                        <span>Трек ПОСЛЕ</span>
                        <InputFile OnChange="e => UploadAudio(e, false)" hidden accept="audio/*" />
                    </label>
                </div>
            </div>

            <footer class="modal-footer-pro">
                <button class="btn-cancel-modal" @onclick="() => showAddPortfolioModal = false">Отмена</button>
                <button class="btn-save-pro" @onclick="SavePortfolioItem" disabled="@(isUploading || string.IsNullOrEmpty(newItem.AudioAfterUrl))">
                    @if (isUploading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Опубликовать работу
                </button>
            </footer>
        </div>
    </div>
}

