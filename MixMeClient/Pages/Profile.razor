@page "/profile"
@page "/profile/{UserId:guid}"
@using MixMeShared
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject MixMeClient.Services.AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<BackgroundGlow />

@* Аудио-движок для портфолио *@
<audio @ref="audioElement" src="@currentTrackUrl"
       @ontimeupdate="OnTimeUpdate"
       @onloadedmetadata="OnLoadedMetadata"
       @onended="() => isPlaying = false"></audio>

<div class="profile-container-full fade-in">
    <div class="profile-scroll-content">

        @if (user == null)
        {
            <div class="loader-box">
                <div class="spinner-premium"></div>
                <p>Загрузка профиля...</p>
            </div>
        }
        else
        {
            bool isEngineer = user.RoleId == 2;
            bool isOwnProfile = Auth.User?.Id == user.Id;

            @* --- ШАПКА ПРОФИЛЯ --- *@
            <header class="profile-hero-card">
                @if (isOwnProfile)
                {
                    <button class="top-logout-btn" @onclick="HandleLogout" title="Выйти из аккаунта">
                        <i class="bi bi-power"></i> <span>Выйти</span>
                    </button>
                }

                <div class="hero-layout">
                    <div class="hero-avatar-zone">
                        <div class="avatar-main-frame">
                            @if (string.IsNullOrEmpty(user.AvatarUrl))
                            {
                                <div class="avatar-placeholder"><i class="bi bi-person-fill"></i></div>
                            }
                            else
                            {
                                <img src="@GetAvatarUrl(user.AvatarUrl)" alt="Avatar" />
                            }

                            @if (isOwnProfile)
                            {
                                <div class="edit-badge" @onclick='() => Nav.NavigateTo("/profile/edit")'>
                                    <i class="bi bi-pencil-fill"></i>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="hero-info-zone">
                        <div class="badge-role @(isEngineer ? "" : "customer")">
                            <i class="bi @(isEngineer ? "bi-patch-check-fill" : "bi-person-check-fill")"></i>
                            @(isEngineer ? "Professional Engineer" : "Verified Customer")
                        </div>

                        <h1 class="user-name-title">@user.Username</h1>
                        <p class="user-full-name">@user.FullName</p>

                        @if (isEngineer)
                        {
                            <div class="stats-grid">
                                <div class="stat-item">
                                    <span class="stat-value">@(portfolioItems?.Count ?? 0)</span>
                                    <span class="stat-label">Работ</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-value">@(engineerData?.ExperienceYears ?? 0)</span>
                                    <span class="stat-label">Лет опыта</span>
                                </div>
                                <div class="stat-item rating">
                                    <span class="stat-value"><i class="bi bi-star-fill"></i> @(engineerData?.AvgRating.ToString("F1") ?? "0.0")</span>
                                    <span class="stat-label">Рейтинг</span>
                                </div>
                            </div>

                            @if (!isOwnProfile)
                            {
                                <div class="profile-actions-wrapper">
                                    <button class="btn-order-main" @onclick="OpenOrderModal">
                                        <i class="bi bi-lightning-charge-fill"></i>
                                        <span>Заказать</span>
                                    </button>

                                    <button class="btn-chat-secondary" @onclick="OpenDirectChat">
                                        <i class="bi bi-chat-dots-fill"></i>
                                        <span>Написать</span>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="customer-since-box">
                                <i class="bi bi-calendar3"></i> На MixMe с @user.CreatedAt.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("ru-RU"))
                            </div>
                        }
                    </div>
                </div>
            </header>

            <div class="profile-grid-layout">
                <aside class="profile-sidebar">
                    <div class="info-glass-card">
                        <div class="info-header">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>@(isEngineer ? "О специалисте" : "О пользователе")</span>
                        </div>
                        <p class="info-text">@(isEngineer ? (engineerData?.Bio ?? "Инженер еще не заполнил биографию.") : "Пользователь MixMe. Ценит качественный звук.")</p>

                        @if (isEngineer && engineerData?.Genres != null && engineerData.Genres.Any())
                        {
                            <div class="tags-container">
                                @foreach (var g in engineerData.Genres)
                                {
                                    <span class="genre-tag">@g.Name</span>
                                }
                            </div>
                        }
                    </div>
                </aside>

                <section class="main-content-zone">
                    @if (isEngineer)
                    {
                        <div class="section-top">
                            <h3>Портфолио</h3>
                            @if (isOwnProfile)
                            {
                                <button class="btn-add-work-styled" @onclick="() => showAddPortfolioModal = true">
                                    <i class="bi bi-plus-lg"></i> Добавить работу
                                </button>
                            }
                        </div>

                        @if (!portfolioItems.Any())
                        {
                            <div class="empty-state"><i class="bi bi-music-note-beamed"></i><p>Список работ пуст</p></div>
                        }
                        else
                        {
                            @foreach (var item in portfolioItems)
                            {
                                var isThisActive = activeItem?.Id == item.Id;
                                var currentProgress = isThisActive ? progressPercent.ToString("F2", CultureInfo.InvariantCulture) : "0";

                                <div class="portfolio-card @(isThisActive ? "active-play" : "")">
                                    <div class="card-top">
                                        <div class="work-meta"><h4>@item.Title</h4><p>@item.Description</p></div>
                                        @if (isPlaying && isThisActive) { <div class="playing-waves"><span></span><span></span><span></span></div> }
                                    </div>
                                    <div class="pro-audio-player">
                                        <button class="play-trigger" @onclick="() => TogglePlay(item)">
                                            <i class="bi @(isPlaying && isThisActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                        <div class="player-controls-area">
                                            <div class="seek-bar-container" @onclick="e => HandleSeek(e)">
                                                <div class="seek-bar-bg">
                                                    <div class="seek-bar-fill" style="width: @(currentProgress)%"></div>
                                                </div>
                                            </div>
                                            <div class="time-and-modes">
                                                <span class="time-display">@(isThisActive ? FormatTime(currentTime) : "0:00") / @(isThisActive ? FormatTime(duration) : "0:00")</span>
                                                <div class="ab-toggle">
                                                    <button class="ab-btn @(!isAfterMode && isThisActive ? "active" : "")" @onclick="() => SetMode(item, false)">BEFORE</button>
                                                    <button class="ab-btn pink @(isAfterMode && isThisActive ? "active" : "")" @onclick="() => SetMode(item, true)">AFTER</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <section class="reviews-section mt-5">
                            <div class="section-top"><h3>Отзывы</h3><div class="avg-rating-big"><i class="bi bi-star-fill"></i> @(engineerData?.AvgRating.ToString("F1") ?? "0.0")</div></div>
                            @if (reviews == null || !reviews.Any()) { <div class="empty-reviews-glass"><i class="bi bi-chat-left-dots"></i><p>Отзывов пока нет.</p></div> }
                            else {
                                <div class="reviews-grid">
                                    @foreach (var review in reviews) {
                                        <div class="review-card-web">
                                            <div class="review-header">
                                                <span class="reviewer-name">@review.ReviewerName</span>
                                                <div class="stars">@for (int i = 1; i <= 5; i++) { <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i> }</div>
                                            </div>
                                            <p class="review-comment">@review.Comment</p>
                                            <span class="review-date">@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                </section>
            </div>
        }
    </div>
</div>

<MixMeClient.Pages.OrderModal @ref="orderModal" EngineerId="@(user?.Id ?? Guid.Empty)" EngineerName="@(user?.Username ?? "")" />

@if (showAddPortfolioModal) {
    <div class="modal-overlay fade-in">
        <div class="modal-glass-card">
            <header class="modal-header-pro"><h3>Новая работа</h3><button class="close-modal" @onclick="() => showAddPortfolioModal = false"><i class="bi bi-x-lg"></i></button></header>
            <div class="modal-body-pro">
                <div class="input-field"><label>Название проекта</label><input type="text" @bind="newItem.Title" /></div>
                <div class="input-field"><label>Описание</label><textarea @bind="newItem.Description" rows="2"></textarea></div>
                <div class="upload-grid-pro">
                    <label class="upload-zone @(string.IsNullOrEmpty(newItem.AudioBeforeUrl) ? "" : "completed")"><i class="bi bi-cloud-upload"></i><span>ДО</span><InputFile OnChange="e => UploadAudio(e, true)" hidden accept="audio/*" /></label>
                    <label class="upload-zone pink @(string.IsNullOrEmpty(newItem.AudioAfterUrl) ? "" : "completed")"><i class="bi bi-cloud-check"></i><span>ПОСЛЕ</span><InputFile OnChange="e => UploadAudio(e, false)" hidden accept="audio/*" /></label>
                </div>
            </div>
            <footer class="modal-footer-pro"><button class="btn-save-pro" @onclick="SavePortfolioItem" disabled="@(isUploading || string.IsNullOrEmpty(newItem.AudioAfterUrl))">Опубликовать</button></footer>
        </div>
    </div>
}
<style>
    /* --- ГЛОБАЛЬНЫЙ КОНТЕЙНЕР И СКРОЛЛБАР --- */
    .profile-container-full {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow-y: auto;
        padding-top: 80px;
        z-index: 10;
        background: transparent;
    }

        .profile-container-full::-webkit-scrollbar {
            width: 8px;
        }

        .profile-container-full::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }

        .profile-container-full::-webkit-scrollbar-thumb {
            background: rgba(233, 30, 99, 0.3);
            border-radius: 10px;
        }

            .profile-container-full::-webkit-scrollbar-thumb:hover {
                background: #E91E63;
            }

    .profile-scroll-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px 100px;
    }

    /* --- ГЕРОЙ И ШАПКА --- */
    .profile-hero-card {
        background: rgba(20, 20, 20, 0.7);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 40px;
        padding: 40px;
        margin-bottom: 40px;
        position: relative;
    }

    .top-logout-btn {
        position: absolute;
        top: 25px;
        right: 30px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.4);
        padding: 8px 15px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 700;
        transition: 0.3s;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .top-logout-btn:hover {
            color: #E91E63;
            border-color: #E91E63;
            background: rgba(233,30,99,0.05);
        }

    .hero-layout {
        display: flex;
        gap: 40px;
        align-items: center;
    }

    .avatar-main-frame {
        width: 180px;
        height: 180px;
        border-radius: 50px;
        overflow: hidden;
        border: 3px solid #E91E63;
        position: relative;
        background: #1a1a1a;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

        .avatar-main-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #222;
        color: #444;
        font-size: 5rem;
    }

    .edit-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: #E91E63;
        width: 35px;
        height: 35px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid #141414;
    }

    .user-name-title {
        font-size: 3.5rem;
        font-weight: 900;
        margin: 0;
        letter-spacing: -2px;
        color: white;
    }

    .user-full-name {
        color: rgba(255,255,255,0.5);
        font-size: 1.2rem;
        margin-top: -5px;
    }

    .badge-role {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(233, 30, 99, 0.15);
        color: #E91E63;
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.75rem;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

        .badge-role.customer {
            background: rgba(0, 188, 212, 0.15);
            color: #00bcd4;
        }

    .stats-grid {
        display: flex;
        gap: 40px;
        margin-top: 30px;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 900;
        color: white;
    }

    .stat-label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        font-weight: 700;
    }

    .stat-item.rating .stat-value {
        color: #FFC107;
    }

    .customer-since-box {
        margin-top: 25px;
        color: rgba(255,255,255,0.3);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* --- СЕТКА И КАРТОЧКИ --- */
    .profile-grid-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 40px;
    }

    .info-glass-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 30px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .info-header {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #E91E63;
        font-weight: 800;
        font-size: 0.9rem;
        margin-bottom: 15px;
        text-transform: uppercase;
    }

        .info-header.blue {
            color: #00bcd4;
        }

    .info-text {
        color: rgba(255,255,255,0.7);
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .genre-tag {
        display: inline-block;
        padding: 6px 14px;
        background: rgba(255,255,255,0.05);
        border-radius: 8px;
        margin-right: 10px;
        margin-bottom: 10px;
        font-size: 0.8rem;
        color: white;
    }

    /* --- ПОРТФОЛИО И ПЛЕЕР --- */
    .section-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .section-top h3 {
            color: white;
            font-weight: 800;
            margin: 0;
        }

    .btn-add-work-styled {
        background: transparent;
        border: 1px dashed #E91E63;
        color: #E91E63;
        padding: 10px 22px;
        border-radius: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-add-work-styled:hover {
            background: #E91E63;
            color: white;
            border-style: solid;
            box-shadow: 0 0 15px rgba(233,30,99,0.3);
        }

    .portfolio-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 30px;
        padding: 25px;
        margin-bottom: 20px;
        transition: 0.3s;
        color: white;
    }

        .portfolio-card.active-play {
            border-color: #E91E63;
            background: rgba(233, 30, 99, 0.03);
        }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .work-meta h4 {
        margin: 0;
        font-size: 1.2rem;
    }

    .work-meta p {
        color: rgba(255,255,255,0.4);
        margin: 5px 0 0;
        font-size: 0.9rem;
    }

    .pro-audio-player {
        display: flex;
        gap: 20px;
        align-items: center;
        margin-top: 20px;
        background: rgba(0,0,0,0.3);
        padding: 15px;
        border-radius: 20px;
    }

    .play-trigger {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        background: #E91E63;
        border: none;
        color: white;
        font-size: 1.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .player-controls-area {
        flex-grow: 1;
    }

    .seek-bar-container {
        height: 24px;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .seek-bar-bg {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        position: relative;
    }

    .seek-bar-fill {
        height: 100%;
        background: #E91E63;
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(233, 30, 99, 0.6);
    }

    .seek-handle {
        width: 14px;
        height: 14px;
        background: white;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
    }

    .time-and-modes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 8px;
    }

    .time-display {
        font-family: monospace;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
    }

    .ab-toggle {
        display: flex;
        background: #111;
        padding: 4px;
        border-radius: 12px;
        gap: 4px;
    }

    .ab-btn {
        background: transparent;
        border: none;
        color: #444;
        font-size: 0.7rem;
        font-weight: 900;
        padding: 6px 12px;
        border-radius: 8px;
        transition: 0.3s;
        cursor: pointer;
    }

        .ab-btn.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }

            .ab-btn.active.pink {
                background: #E91E63;
            }

    /* --- ОТЗЫВЫ СТИЛИ --- */
    .avg-rating-big {
        background: rgba(255, 193, 7, 0.1);
        color: #FFC107;
        padding: 8px 16px;
        border-radius: 15px;
        font-weight: 900;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .reviews-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 15px;
    }

    .review-card-web {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        padding: 25px;
        border-radius: 25px;
        transition: 0.3s;
    }

        .review-card-web:hover {
            background: rgba(255,255,255,0.04);
            border-color: rgba(255,255,255,0.1);
        }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .reviewer-name {
        font-weight: 800;
        color: #E91E63;
        font-size: 1rem;
    }

    .stars {
        color: #FFC107;
        font-size: 0.85rem;
    }

    .review-comment {
        margin: 15px 0;
        font-size: 0.95rem;
        color: rgba(255,255,255,0.8);
        line-height: 1.5;
    }

    .review-date {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.3);
        font-weight: 600;
    }

    .empty-reviews-glass {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 30px;
        padding: 40px;
        text-align: center;
        color: rgba(255,255,255,0.2);
    }

        .empty-reviews-glass i {
            font-size: 3rem;
            display: block;
            margin-bottom: 10px;
            opacity: 0.3;
        }

    /* --- ПРОЧЕЕ --- */
    .playing-waves {
        display: flex;
        gap: 3px;
        align-items: flex-end;
        height: 20px;
    }

        .playing-waves span {
            width: 3px;
            background: #E91E63;
            border-radius: 3px;
            animation: wave-anim 0.8s ease-in-out infinite alternate;
        }

            .playing-waves span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .playing-waves span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes wave-anim {
        from {
            height: 5px;
        }

        to {
            height: 20px;
        }
    }

    /* МОДАЛКА */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-glass-card {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 35px;
        width: 500px;
        padding: 30px;
    }

    .modal-header-pro {
        display: flex;
        justify-content: space-between;
        margin-bottom: 25px;
        color: white;
    }

    .input-field {
        margin-bottom: 20px;
    }

        .input-field label {
            display: block;
            color: rgba(255,255,255,0.4);
            font-size: 0.8rem;
            margin-bottom: 8px;
        }

        .input-field input, .input-field textarea {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 12px;
            color: white;
        }

    .upload-grid-pro {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .upload-zone {
        background: rgba(255,255,255,0.03);
        border: 2px dashed rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        color: rgba(255,255,255,0.4);
    }

        .upload-zone.completed {
            border-color: #4CAF50;
            color: #4CAF50;
        }

        .upload-zone.pink.completed {
            border-color: #E91E63;
            color: #E91E63;
        }

    .modal-footer-pro {
        display: flex;
        justify-content: flex-end;
