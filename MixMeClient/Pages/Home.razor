@page "/"
@inject NavigationManager Nav
@inject IJSRuntime JS

<BackgroundGlow />

<div class="cursor-glow" id="cursorGlow"></div>

<div class="main-container" @onmousemove="HandleMouseMove">
    @if (currentStep == 1)
    {
        <!-- ЭКРАН 1: ЛЕНДИНГ -->
        <div class="landing-wrapper fade-in">
            <section class="hero-section">
                <div class="top-center-logo-area" style="transform: translate(calc(-50% + @(mouseX/50)px), @(mouseY/50)px)">
                    <div class="logo-waves">
                        <div class="wave-wiggly"></div>
                        <div class="wave-wiggly delay"></div>
                    </div>
                    <img src="images/logo.png" class="hero-logo floating" alt="logo" />
                </div>

                <div class="bottom-left-info" style="transform: translate(@(mouseX/80)px, @(mouseY/80)px)">
                    <h1 class="main-title">MixMe</h1>
                    <p class="main-subtitle">Профессиональное сведение и мастеринг в одном приложении.</p>
                    <button class="premium-button" @onclick="() => currentStep = 2">
                        Начать работу <span class="ms-2">→</span>
                    </button>
                </div>

                <div class="scroll-indicator">
                    <div class="mouse-icon"><div class="wheel"></div></div>
                </div>
            </section>

            <!-- СЕКЦИЯ КАРТОЧЕК -->
            <section class="features-section">
                <h2 class="section-title">Почему выбирают нас?</h2>
                <div class="feature-cards-grid">
                    <div class="f-card glass-effect">
                        <div class="f-icon"><i class="bi bi-shield-check"></i></div>
                        <h3>Безопасная сделка</h3>
                        <p>Деньги резервируются системой и выплачиваются инженеру только после подтверждения качества.</p>
                    </div>
                    <div class="f-card glass-effect highlight">
                        <div class="f-icon"><i class="bi bi-waveform"></i></div>
                        <h3>A/B Тестирование</h3>
                        <p>Сравнивайте исходник и финальный результат в реальном времени в нашем плеере.</p>
                    </div>
                    <div class="f-card glass-effect">
                        <div class="f-icon"><i class="bi bi-person-badge"></i></div>
                        <h3>Топ Исполнители</h3>
                        <p>Мы верифицируем каждого инженера. Работайте с лучшими профи в своем жанре.</p>
                    </div>
                </div>
            </section>
        </div>
    }
    else
    {
        <!-- ЭКРАН 2: ВХОД -->
        <div class="auth-screen fade-in">
            <div class="auth-box">
                <img src="images/logo.png" class="auth-logo-top" alt="logo" />

                <div class="auth-glass-panel">
                    <h2 class="auth-header">Вход</h2>

                    <div class="role-list">
                        <div class="role-card @(role == 1 ? "is-active" : "")" @onclick="() => SelectRole(1)">
                            <div class="role-img-container"><img src="images/icon_customer.png" /></div>
                            <div class="role-info">
                                <span class="role-title">Я ищу профессионала</span>
                                <span class="role-desc">Мне нужно свести трек</span>
                            </div>
                        </div>

                        <div class="role-card @(role == 2 ? "is-active" : "")" @onclick="() => SelectRole(2)">
                            <div class="role-img-container"><img src="images/icon_engineer.png" /></div>
                            <div class="role-info">
                                <span class="role-title">Я создаю шедевры</span>
                                <span class="role-desc">Я mix/master engineer</span>
                            </div>
                        </div>
                    </div>

                    @* СООБЩЕНИЕ ВАЛИДАЦИИ С ЦВЕТОМ И АНИМАЦИЕЙ *@
                    @if (!string.IsNullOrEmpty(roleErrorMessage))
                    {
                        <p class="auth-error-msg">@roleErrorMessage</p>
                    }

                    <div class="auth-actions">
                        <button class="btn-primary" @onclick='() => Nav.NavigateTo("/login")'>Войти</button>
                        <button class="btn-secondary" @onclick="GoToRegister">Зарегистрироваться</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Глобальные настройки */
    .main-container {
        width: 100vw;
        height: 100vh;
        color: white;
        overflow: hidden;
        position: relative;
        font-family: 'Inter', sans-serif;
    }

    .fade-in {
        animation: fadeInEffect 0.6s ease-out forwards;
    }

    @@keyframes fadeInEffect {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* --- ЛЕНДИНГ --- */
    .landing-wrapper {
        height: 100vh;
        overflow-y: auto;
        scroll-behavior: smooth;
    }

    .hero-section {
        height: 100vh;
        position: relative;
    }

    .top-center-logo-area {
        position: absolute;
        top: 15%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-logo {
        height: 140px;
        z-index: 5;
        filter: drop-shadow(0 0 25px rgba(233,30,99,0.3));
    }

    .logo-waves {
        position: absolute;
        width: 350px;
        height: 350px;
    }

    .wave-wiggly {
        position: absolute;
        inset: 0;
        border: 2px solid rgba(233,30,99,0.2);
        border-radius: 43% 57% 73% 27% / 45% 50% 65% 55%;
        animation: rot 10s linear infinite;
    }

        .wave-wiggly.delay {
            animation-duration: 15s;
            animation-direction: reverse;
            border-color: rgba(255,255,255,0.05);
        }

    @@keyframes rot {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .bottom-left-info {
        position: absolute;
        bottom: 80px;
        left: 60px;
        text-align: left;
    }

    .main-title {
        font-size: 6rem;
        font-weight: 900;
        color: #E91E63;
        margin: 0;
        letter-spacing: -4px;
        line-height: 1;
    }

    .main-subtitle {
        font-size: 1.4rem;
        opacity: 0.7;
        margin: 20px 0 30px 0;
        max-width: 500px;
    }

    .premium-button {
        background: rgba(233,30,99,0.1);
        border: 1px solid #E91E63;
        color: white;
        padding: 14px 40px;
        border-radius: 30px;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: 0.3s;
        font-weight: 600;
    }

        .premium-button:hover {
            background: #E91E63;
            box-shadow: 0 0 25px rgba(233,30,99,0.4);
        }

    .features-section {
        padding: 100px 40px;
        background: transparent;
    }

    .section-title {
        font-size: 2.8rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 60px;
    }

    .feature-cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .f-card {
        padding: 40px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 30px;
        backdrop-filter: blur(15px);
        text-align: left;
        transition: 0.3s;
    }

        .f-card:hover {
            transform: translateY(-10px);
            border-color: #E91E63;
        }

    .f-icon {
        font-size: 2.2rem;
        color: #E91E63;
        margin-bottom: 20px;
    }

    .f-card h3 {
        font-size: 1.4rem;
        margin-bottom: 12px;
        font-weight: 700;
    }

    .f-card p {
        opacity: 0.5;
        line-height: 1.5;
        font-size: 0.95rem;
    }

    /* --- ЭКРАН ВХОДА --- */
    .auth-screen {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        width: 100vw;
    }

    .auth-box {
        width: 100%;
        max-width: 460px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 25px;
    }

    .auth-logo-top {
        height: 75px;
        filter: drop-shadow(0 0 15px rgba(233,30,99,0.3));
    }

    .auth-glass-panel {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(40px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 40px;
        padding: 40px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        text-align: center;
    }

    .auth-header {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 30px;
    }

    .role-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 20px;
    }

    .role-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 18px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        cursor: pointer;
        transition: 0.2s;
        text-align: left;
    }

        .role-card.is-active {
            background: rgba(233, 30, 99, 0.12);
            border-color: #E91E63;
            box-shadow: 0 0 15px rgba(233, 30, 99, 0.2);
        }

    .role-img-container {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .role-img-container img {
            width: 100%;
            height: auto;
        }

    .role-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .role-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: #fff;
        line-height: 1.2;
    }

    .role-desc {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
    }

    /* ВАЛИДАЦИЯ (ИСПРАВЛЕНО) */
    .auth-error-msg {
        color: #ff5252;
        font-size: 0.95rem;
        margin-bottom: 20px;
        font-weight: 600;
        animation: shake 0.4s ease-in-out forwards;
        text-shadow: 0 0 10px rgba(255, 82, 82, 0.3);
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-6px);
        }

        75% {
            transform: translateX(6px);
        }
    }

    .btn-primary {
        background: #E91E63; /* Возвращаем розовый цвет */
        color: white;
        border: none;
        padding: 16px;
        border-radius: 18px;
        font-weight: 700;
        cursor: pointer;
        font-size: 1rem;
        width: 100%;
        margin-bottom: 12px;
        /* Добавляем свечение и плавный переход */
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(233, 30, 99, 0.3);
    }

        .btn-primary:hover {
            background: #ff2e75;
            transform: translateY(-2px);
            /* Усиливаем свечение при наведении */
            box-shadow: 0 15px 25px rgba(233, 30, 99, 0.4);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 16px;
        border-radius: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
        width: 100%;
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }

    .cursor-glow {
        position: fixed;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(233,30,99,0.1) 0%, transparent 70%);
        pointer-events: none;
        z-index: 1;
        transform: translate(-50%, -50%);
    }

    .scroll-indicator {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0.5;
    }

    .mouse-icon {
        width: 22px;
        height: 36px;
        border: 2px solid white;
        border-radius: 12px;
        position: relative;
        margin: 0 auto;
    }

    .wheel {
        width: 3px;
        height: 6px;
        background: #E91E63;
        border-radius: 2px;
        position: absolute;
        top: 6px;
        left: 50%;
        transform: translateX(-50%);
        animation: sc 1.5s infinite;
    }

    @@keyframes sc {
        0% {
            opacity: 1;
            top: 6px;
        }

        100% {
            opacity: 0;
            top: 18px;
        }
    }

    .floating {
        animation: fl 6s ease-in-out infinite;
    }

    @@keyframes fl {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-12px);
        }
    }
</style>

@code {
    private int currentStep = 1;
    private int role = 0;
    private string? roleErrorMessage;
    private double mouseX;
    private double mouseY;

    [Parameter][SupplyParameterFromQuery] public string? step { get; set; }

    protected override void OnParametersSet()
    {
        if (step == "2") currentStep = 2;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        mouseX = e.ClientX - (1920 / 2);
        mouseY = e.ClientY - (1080 / 2);
        JS.InvokeVoidAsync("updateCursorGlow", e.ClientX, e.ClientY);
    }

    private void SelectRole(int selectedRole)
    {
        role = selectedRole;
        roleErrorMessage = null;
    }

    private void GoToRegister()
    {
        if (role == 0)
        {
            roleErrorMessage = "Выберите свою сторону в мире звука";
            return;
        }
        Nav.NavigateTo($"/register/{(role == 1 ? "customer" : "engineer")}");
    }
}